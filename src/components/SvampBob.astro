---
// Svamp-Bob-temat: Ottos mönster i bakgrunden, svamplisten i toppen, svampar
// som flyger in från alla håll och skrattar, och en ljudknapp. Stil och skript
// ligger som vanliga filer i public/svampbob/ så att de bara laddas när temat
// är aktivt och inte hamnar i sajtens vanliga paket.
// latt: den lugna varianten för alla sidor utom startsidan (inget skratt av
// sig självt, bara en enstaka svamp då och då).
interface Props { latt?: boolean }
const { latt = false } = Astro.props;
const V = '6';
---
<link rel="stylesheet" href={`/svampbob/tema.css?v=${V}`} />
<div class:list={['svampbob-hav', { 'svampbob-latt': latt }]} aria-hidden="true"></div>
{!latt && (
  <div class="svampbob-bubblor" aria-hidden="true">
    {Array.from({ length: 16 }).map((_, i) => <span style={`--i:${i}`}></span>)}
  </div>
)}
<div id="svampbob-lager" data-latt={latt ? '1' : '0'} aria-hidden="true"></div>
<button id="svampbob-ljud" type="button" title="Skratt av/på" aria-label="Skratt av eller på">🔊</button>
<audio id="svampbob-skratt" src="/svampbob/skratt.mp3" preload="auto"></audio>
<script is:inline src={`/svampbob/tema.js?v=${V}`} defer></script>
