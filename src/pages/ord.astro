---
import Base from '../layouts/Base.astro';
import InstallApp from '../components/InstallApp.astro';
import { getSessionFromCookies } from '../lib/auth.js';
import { upcomingExams } from '../lib/provdatum.js';
import pool from '../lib/db.js';

const ADMIN_EMAIL = 'snillsparv@gmail.com';
const user = await getSessionFromCookies(Astro.request.headers.get('cookie'));
const isAdmin = !!user && user.email === ADMIN_EMAIL;
const exams = upcomingExams(2);
// Utan session visas startvyn med riktiga siffror ändå; gästkontot skapas
// först när besökaren faktiskt börjar träna.
const { rows: [wordCount] } = await pool.query('SELECT COUNT(*)::int AS n FROM mnemonic_words');
---

<Base
  title="Ordträning – lär dig högskoleprovets ord – HPAkuten"
  description="Lär dig över 4000 typiska högskoleprovsord gratis, med etymologi, minnesregler och spaced repetition. Några ord om dagen blir snart tusentals."
  manifest="/ordtraning.webmanifest"
  appleIcon="/icons/ordtraning-apple-180.png"
  appName="Ordträning"
  themeColor="#1a1a2e"
>
  <div class="page-content">
    <div class="container ot-page">
      <div class="head">
        <h1>Ordträning</h1>
        <p class="lead">Lär dig orden som brukar dyka upp på högskoleprovet, med etymologi, minnesregler och repetition precis när du behöver den.</p>
      </div>

      <div class="sr-info">
        <button class="sr-info-toggle" id="sr-info-toggle" type="button">ℹ️ Så fungerar spaced repetition</button>
        <div id="sr-info-body" hidden>
          <p>Varje ord repeteras precis innan du annars skulle glömma det: först efter 1 dag, sedan 3 dagar, 1 vecka, 2 veckor, 5 veckor och till sist 3 månader. Svarar du rätt växer intervallet, svarar du fel börjar ordet om och repeteras samma dag tills det sitter.</p>
          <p>På så vis fastnar orden i långtidsminnet med så få repetitioner som möjligt. Det viktigaste är att komma tillbaka varje dag, hellre korta pass ofta än långa pass sällan.</p>
          <p><a href="https://www.youtube.com/watch?v=Xa2HgOwGG08" target="_blank" rel="noopener">▶ Se videon där jag förklarar spaced repetition</a></p>
        </div>
      </div>

      <InstallApp
        name="Ordträning"
        note="Egen ikon på hemskärmen som öppnas direkt i orden."
        storageKey="ordtraning-install"
      />

      {isAdmin && (
        <div class="dev">
          <span class="dev-label">Testverktyg:</span>
          <button id="dev-day" class="dev-btn" type="button">⏩ Simulera nästa dag</button>
          <button id="dev-week" class="dev-btn" type="button">⏩ Hoppa 7 dagar</button>
          <span id="dev-msg" class="dev-msg"></span>
        </div>
      )}

      <div id="app" class="app"><div class="loading">Laddar…</div></div>
    </div>
  </div>
</Base>

<style is:global>
  .ot-page .head { margin-bottom: 1rem; text-align: center; }
  .ot-page .head .lead { margin-left: auto; margin-right: auto; }
  .ot-page .beta { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
    background: #eef2ff; color: #2563eb; padding: 0.15rem 0.5rem; border-radius: 999px; vertical-align: middle; }
  .ot-page .lead { color: #64748b; max-width: 60ch; }

  .ot-page .dev { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin-bottom: 1.4rem;
    padding: 0.7rem 0.9rem; background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 10px; }
  .ot-page .dev-label { font-size: 0.78rem; font-weight: 700; color: #64748b; }
  .ot-page .dev-btn { font: inherit; font-size: 0.82rem; font-weight: 600; padding: 0.35rem 0.7rem; border-radius: 8px;
    border: 1.5px solid #e2e8f0; background: #fff; color: #1a1a2e; cursor: pointer; }
  .ot-page .dev-btn:hover { border-color: #2563eb; color: #2563eb; }
  .ot-page .dev-danger:hover { border-color: #ef4444; color: #ef4444; }
  .ot-page .dev-msg { font-size: 0.8rem; color: #10b981; font-weight: 600; }

  /* Kontouppmuntran för gäster: liten i lägena, större efter första passet. */
  .ot-page a.btn { display: block; text-align: center; text-decoration: none; box-sizing: border-box; }
  .ot-page .gnudge { margin: 0 0 1rem; background: #eff6ff; border: 1.5px solid #bfdbfe;
    border-radius: 12px; padding: 0.8rem 1rem; }
  .ot-page .gnudge p { margin: 0 0 0.6rem; font-size: 0.9rem; color: #334155; }
  .ot-page .gnudge-row { display: flex; align-items: center; gap: 0.9rem; flex-wrap: wrap; }
  .ot-page .gnudge-btn { width: auto; padding: 0.55rem 1rem; font-size: 0.9rem; }
  .ot-page .gnudge .link-btn { color: #64748b; }
  .ot-page .gsave { background: #f0fdf4; border: 1.5px solid #bbf7d0; border-radius: 12px;
    padding: 1rem 1.1rem 0.9rem; margin: 0 0 1rem; text-align: center; }
  .ot-page .gsave h3 { margin: 0 0 0.3rem; color: #1a1a2e; }
  .ot-page .gsave p { margin: 0; font-size: 0.92rem; color: #475569; line-height: 1.5; }
  .ot-page .gsave .btn-row { margin-top: 0.9rem; }
  .ot-page .gsave .link-btn { color: #64748b; }
  .ot-page .gsave-line { text-align: center; font-size: 0.88rem; color: #64748b; margin: 0 0 1rem; }
  .ot-page .gsave-line a { color: #2563eb; font-weight: 700; }

  .ot-page .app { display: flex; justify-content: center; }
  .ot-page .loading { color: #64748b; padding: 3rem; }
  .ot-page .card { width: 100%; max-width: 560px; background: #fff; border: 1px solid #e2e8f0; border-radius: 18px;
    box-shadow: 0 10px 30px rgba(20,24,43,.08); overflow: hidden; }
  .ot-page .card-top { display: flex; justify-content: space-between; align-items: center; padding: 0.8rem 1.2rem; border-bottom: 1px solid #e2e8f0; }
  .ot-page .card-top .top-left { display: flex; align-items: center; gap: 0.5rem; }
  .ot-page .card-top .tag { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #2563eb; }
  .ot-page .back-btn { font: inherit; font-size: 1.2rem; line-height: 1; width: 30px; height: 30px; display: grid; place-items: center;
    border: 1.5px solid #e2e8f0; background: #fff; color: #64748b; border-radius: 8px; cursor: pointer; }
  .ot-page .back-btn:hover { border-color: #2563eb; color: #2563eb; background: #eff6ff; }
  .ot-page .card-top .step { font-size: 0.78rem; color: #64748b; font-variant-numeric: tabular-nums; }
  .ot-page .bar { height: 5px; background: #e2e8f0; }
  .ot-page .bar > i { display: block; height: 100%; background: #2563eb; transition: width 0.35s ease; }
  .ot-page .body { padding: 1.4rem 1.4rem 1.5rem; }

  .ot-page .ring-row { display: flex; flex-direction: column; align-items: center; gap: 0.55rem; margin: 0.4rem 0 1.2rem; text-align: center; }
  .ot-page .ring { width: 212px; height: 212px; border-radius: 50%; display: grid; place-items: center; flex-shrink: 0;
    animation: ot-pop 0.45s cubic-bezier(0.34, 1.3, 0.64, 1) both; }
  .ot-page .ring > div { width: 176px; height: 176px; border-radius: 50%; background: #fff; padding: 3px;
    box-sizing: border-box; display: grid; place-items: center; }
  .ot-page .ring--sweep { animation: ot-pop 0.45s cubic-bezier(0.34, 1.3, 0.64, 1) both, ot-sweep 1.1s cubic-bezier(0.33, 1, 0.68, 1) both; }
  @keyframes ot-pop { from { transform: scale(0.88); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  @keyframes ot-sweep {
    from { --ot-deg: 0deg; --ot-track: 0deg; }
    to { --ot-deg: var(--ot-goal, 0deg); --ot-track: 360deg; }
  }

  /* Nivåansiktet i mitten av ringen: tonar upp medan ringen snurrar fram och
     studsar till när man klickar på det. */
  /* Ansiktet behåller sin storlek och flyter i mitten av den större ringen. */
  .ot-page .face { width: 146px; height: 146px; border-radius: 50%; object-fit: contain; display: block;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent; -webkit-touch-callout: none;
    -webkit-user-select: none; user-select: none; }
  /* Intoningen ligger på en klass som tas bort när den spelat klart, annars
     startar den om varje gång studsklassen försvinner. */
  .ot-page .face.is-in { animation: ot-face-in 1.1s cubic-bezier(0.33, 1, 0.68, 1) both; }
  .ot-page .face.is-bounce { animation: ot-face-bounce 0.6s cubic-bezier(0.34, 1.4, 0.64, 1) both; }
  @keyframes ot-face-in { from { opacity: 0; transform: scale(0.8); } to { opacity: 1; transform: scale(1); } }
  @keyframes ot-face-bounce {
    0% { transform: scale(1) translateY(0); }
    18% { transform: scale(0.94) translateY(2px); }
    42% { transform: scale(1.04) translateY(-9px); }
    64% { transform: scale(0.98) translateY(0); }
    82% { transform: scale(1.01) translateY(-3px); }
    100% { transform: scale(1) translateY(0); }
  }
  .ot-page .ring-level { font-size: 0.74rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
    color: #2563eb; background: #eef2ff; border-radius: 999px; padding: 0.2rem 0.7rem; margin-top: 0.1rem; }
  .ot-page .ring-level b { font-variant-numeric: tabular-nums; }
  .ot-page .ring-count { font-size: 0.86rem; color: #64748b; }
  .ot-page .ring-count b { color: #1a1a2e; font-variant-numeric: tabular-nums; }
  .ot-page .streak { font-size: 0.8rem; font-weight: 700; color: #b45309; background: #fffbeb;
    border: 1px solid #fde68a; border-radius: 999px; padding: 0.2rem 0.7rem; }

  /* Nivåfirande: overlay med det nya ansiktet och lite konfetti. */
  .ot-lvlup { position: fixed; inset: 0; background: rgba(15, 23, 42, 0.55); display: grid;
    place-items: center; z-index: 300; animation: ot-fade 0.25s ease both; }
  .ot-lvlup-card { position: relative; overflow: hidden; background: #fff; border-radius: 18px;
    padding: 2rem 2.2rem 1.6rem; text-align: center; max-width: 320px; margin: 1rem;
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.35); animation: ot-pop 0.45s cubic-bezier(0.34, 1.3, 0.64, 1) both; }
  .ot-lvlup-face { width: 150px; height: 150px; border-radius: 50%; border: 7px solid #2563eb;
    background: #fff; object-fit: contain; animation: ot-lvl-face 0.9s cubic-bezier(0.34, 1.4, 0.64, 1) 0.2s both; }
  .ot-lvlup-card h3 { margin: 0.8rem 0 0.2rem; font-size: 1.5rem; color: #1a1a2e; }
  .ot-lvlup-card p { margin: 0 0 1.1rem; color: #64748b; font-size: 0.92rem; }
  .ot-lvlup-conf { position: absolute; inset: 0; pointer-events: none; }
  .ot-lvlup-conf i { position: absolute; top: -14px; width: 8px; height: 14px; border-radius: 2px;
    opacity: 0; animation: ot-conf 1.7s ease-in both; }
  @keyframes ot-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes ot-lvl-face { 0% { transform: scale(0.2); opacity: 0; } 60% { transform: scale(1.08); opacity: 1; }
    80% { transform: scale(0.96); } 100% { transform: scale(1); opacity: 1; } }
  @keyframes ot-conf { 0% { opacity: 1; transform: translateY(0) rotate(0deg); }
    100% { opacity: 0; transform: translateY(340px) rotate(540deg); } }
  @media (prefers-reduced-motion: reduce) {
    .ot-page .ring, .ot-page .ring--sweep, .ot-page .face.is-in,
    .ot-lvlup, .ot-lvlup-card, .ot-lvlup-face, .ot-lvlup-conf i { animation: none; }
  }

  /* Introrundtur: fyra skuggremsor runt det aktuella elementet, en ram runt
     hålet och en pratbubbla. Ligger på body, utanför .ot-page. */
  .ot-tour { position: fixed; inset: 0; z-index: 400; animation: ot-fade 0.25s ease both; }
  .ot-tour-shade { position: fixed; background: rgba(15, 23, 42, 0.6); }
  .ot-tour-frame { position: fixed; border-radius: 10px; box-shadow: 0 0 0 3px #60a5fa; cursor: default; }
  .ot-tour-tip { position: fixed; left: 50%; transform: translateX(-50%); width: min(92vw, 360px);
    box-sizing: border-box; background: #fff; border-radius: 14px; padding: 1rem 1.1rem 1.05rem;
    box-shadow: 0 18px 50px rgba(15, 23, 42, 0.4); transition: top 0.25s ease; }
  .ot-tour-count { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em; color: #2563eb;
    text-transform: uppercase; margin-bottom: 0.3rem; }
  .ot-tour-tip h4 { margin: 0 0 0.3rem; font-size: 1.05rem; color: #1a1a2e; }
  .ot-tour-tip p { margin: 0 0 0.85rem; font-size: 0.92rem; line-height: 1.55; color: #475569; }
  .ot-tour-btns { display: flex; align-items: center; justify-content: space-between; gap: 0.8rem; }
  .ot-tour-skip { font: inherit; font-size: 0.85rem; background: none; border: none; color: #94a3b8;
    cursor: pointer; text-decoration: underline; }
  .ot-tour-skip:hover { color: #64748b; }
  .ot-tour-next { font: inherit; font-weight: 700; font-size: 0.92rem; background: #2563eb; color: #fff;
    border: none; border-radius: 10px; padding: 0.55rem 1.2rem; cursor: pointer; }
  .ot-tour-next:hover { background: #1d4ed8; }
  @media (prefers-reduced-motion: reduce) { .ot-tour, .ot-tour-tip { animation: none; transition: none; } }

  .ot-page .calc { border-top: 1px dashed #e2e8f0; margin-top: 0.5rem; padding-top: 0.6rem; }
  .ot-page .calc-head { font-size: 0.78rem; color: #64748b; margin-bottom: 0.35rem; }
  .ot-page .calc-row { padding: 0.14rem 0; font-size: 0.84rem; line-height: 1.4; color: #64748b; }
  .ot-page .calc-n { font-weight: 700; color: #1a1a2e; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .ot-page .calc-prel { font-size: 0.72rem; color: #94a3b8; white-space: nowrap; }
  .ot-page .stat-lines { display: flex; flex-direction: column; align-items: flex-start; gap: 0.4rem; margin: 0 auto 1.4rem; width: fit-content; }
  .ot-page .stat-line { display: flex; align-items: center; gap: 0.6rem; font-size: 0.86rem; color: #64748b; }
  .ot-page .today-line { font-size: 1rem; color: #1a1a2e; }
  .ot-page .stat-line .dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }
  .ot-page .stat-line b { color: #1a1a2e; font-variant-numeric: tabular-nums; }

  .ot-page .settings { border: 1px solid #e2e8f0; border-radius: 10px; padding: 0.6rem 0.9rem; margin-bottom: 0.2rem; background: #fbfcfe; }
  .ot-page .set-row { display: flex; align-items: center; justify-content: space-between; gap: 0.8rem; padding: 0.3rem 0; }
  .ot-page .set-label { font-size: 0.9rem; color: #334155; }
  .ot-page .stepper { display: flex; align-items: center; gap: 0.6rem; }
  .ot-page .stepper b { min-width: 2.2ch; text-align: center; font-variant-numeric: tabular-nums; font-size: 1rem; }
  .ot-page .st-btn { width: 30px; height: 30px; border-radius: 8px; border: 1.5px solid #e2e8f0; background: #fff;
    font-size: 1.1rem; font-weight: 700; line-height: 1; color: #2563eb; cursor: pointer; display: grid; place-items: center; }
  .ot-page .st-btn:hover { border-color: #2563eb; background: #eff6ff; }
  .ot-page .set-note { font-size: 0.76rem; color: #94a3b8; margin: 0.35rem 0 0; }
  .ot-page .set-more { font: inherit; font-size: 0.8rem; font-weight: 600; color: #64748b; background: none; border: none;
    padding: 0.35rem 0 0.1rem; cursor: pointer; }
  .ot-page .set-more:hover { color: #2563eb; }
  .ot-page .ign { border-top: 1px dashed #e2e8f0; margin-top: 0.55rem; padding-top: 0.6rem; }
  .ot-page .ign-head { font-size: 0.78rem; font-weight: 700; color: #64748b; margin-bottom: 0.4rem; }
  .ot-page .ign-list { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .ot-page .ign-item { font: inherit; font-size: 0.8rem; color: #334155; background: #fff; border: 1px solid #e2e8f0;
    border-radius: 999px; padding: 0.22rem 0.6rem; cursor: pointer; }
  .ot-page .ign-item span { color: #2563eb; font-weight: 700; }
  .ot-page .ign-item:hover { border-color: #2563eb; color: #2563eb; }
  .ot-page .ign-more { font-size: 0.78rem; color: #94a3b8; align-self: center; }
  .ot-page .ign-all { font-size: 0.8rem; margin-top: 0.45rem; }

  .ot-page .btn { font: inherit; font-weight: 700; font-size: 0.98rem; border-radius: 10px; padding: 0.85rem 1.2rem;
    cursor: pointer; border: 2px solid transparent; width: 100%; }
  .ot-page .btn-primary { background: #2563eb; color: #fff; } .ot-page .btn-primary:hover { background: #1d4ed8; }
  .ot-page .btn-outline { background: #fff; border-color: #e2e8f0; color: #1a1a2e; } .ot-page .btn-outline:hover { border-color: #2563eb; color: #2563eb; }
  .ot-page .btn-row { display: flex; flex-direction: column; gap: 0.55rem; margin-top: 1.2rem; }

  .ot-page .chip { display: inline-block; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase;
    padding: 0.22rem 0.6rem; border-radius: 999px; margin-bottom: 0.7rem; }
  .ot-page .chip-new { background: #eef2ff; color: #2563eb; } .ot-page .chip-rep { background: #fef3c7; color: #b45309; }
  .ot-page .learn-card { display: flex; flex-direction: column; }
  .ot-page .w-img { display: block; width: 140px; height: 140px; object-fit: contain; background: #fff; border: 1px solid #e2e8f0;
    border-radius: 14px; padding: 6px; margin: 0.2rem auto 0.7rem; }
  .ot-page .rel { margin: 0.55rem 0 0.1rem; }
  .ot-page .rel-label { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #94a3b8; display: block; margin-bottom: 0.3rem; }
  .ot-page .rel-words { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .ot-page .rel-item { background: #f1f5f9; border-radius: 8px; padding: 0.25rem 0.55rem; font-size: 0.86rem; color: #334155; }
  .ot-page .rel-item b { color: #1a1a2e; }
  .ot-page .rel-item i { color: #64748b; font-style: normal; }
  .ot-page .rel-none { color: #cbd5e1; }

  .ot-page .reveal-row { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0.8rem 0 0.7rem; }
  .ot-page .help-toggle { font: inherit; font-size: 0.9rem; font-weight: 700; color: #2563eb; background: #eff6ff;
    border: 1.5px solid #bfdbfe; border-radius: 10px; padding: 0.55rem 0.9rem; cursor: pointer; flex: 1 1 45%;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease; }
  .ot-page .help-toggle:hover { background: #dbeafe; }
  .ot-page .help-toggle.is-open { background: #2563eb; border-color: #2563eb; color: #fff; }
  .ot-page .w-word { font-size: 2.1rem; font-weight: 800; letter-spacing: -0.01em; line-height: 1.12; margin: 0 0 0.5rem; text-align: center; }
  .ot-page .w-def { display: block; width: fit-content; max-width: 100%; margin: 0 auto 1rem; text-align: center;
    background: #eff6ff; color: #1d4ed8; font-weight: 700; font-size: 1.12rem; padding: 0.35rem 0.9rem; border-radius: 10px; }
  .ot-page .mnemo { background: #fffbeb; border: 1px solid #fde68a; border-radius: 10px; padding: 0.85rem 1rem; margin-bottom: 0.8rem; }
  .ot-page .mnemo .m-label { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #b45309; margin-bottom: 0.3rem; }
  .ot-page .mnemo p { margin: 0; font-size: 1.02rem; line-height: 1.55; }
  .ot-page .hook { background: #fef3c7; color: #92400e; font-weight: 700; border-radius: 3px; padding: 0 2px; }
  .ot-page .example { font-style: italic; color: #334155; font-size: 0.97rem; margin: 0.2rem 0 0.9rem; }
  .ot-page .example strong { font-style: normal; color: #1a1a2e; }
  .ot-page .ex-label { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #94a3b8; display: block; margin-bottom: 0.15rem; font-style: normal; }
  /* Ligger fristående under ingressen, i samma bredd som appkortet. */
  .ot-page .sr-info { text-align: center; max-width: 560px; margin: -0.3rem auto 1.3rem; }
  .ot-page .sr-info-toggle { font: inherit; font-size: 0.8rem; font-weight: 600; color: #64748b; background: none;
    border: none; cursor: pointer; padding: 0.2rem 0.4rem; }
  .ot-page .sr-info-toggle:hover { color: #2563eb; }
  .ot-page #sr-info-body { text-align: left; font-size: 0.86rem; color: #475569; background: #f8fafc;
    border: 1px solid #e2e8f0; border-radius: 10px; padding: 0.8rem 1rem; margin-top: 0.5rem; line-height: 1.6; }
  .ot-page #sr-info-body p { margin: 0 0 0.5rem; }
  .ot-page #sr-info-body p:last-child { margin: 0; }
  .ot-page #sr-info-body a { color: #2563eb; font-weight: 700; text-decoration: none; }
  .ot-page #sr-info-body a:hover { text-decoration: underline; }

  /* Toppbild inne i ett läge: går kant till kant genom att äta upp body-paddingen. */
  .ot-page .hero { display: block; width: calc(100% + 2.8rem); margin: -1.4rem -1.4rem 1.1rem;
    height: 132px; object-fit: cover; }

  .ot-page .mode-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; margin-top: 0.9rem; }
  /* Lägesknapparna är foton med texten på en mörk tonplatta i nederkant. */
  .ot-page .mode-btn { font: inherit; position: relative; isolation: isolate; overflow: hidden; text-align: left;
    display: flex; flex-direction: column; justify-content: flex-end; min-height: 150px; padding: 0;
    border: 1.5px solid #e2e8f0; border-radius: 12px; background: #fbfcfe; cursor: pointer; }
  .ot-page .mode-btn:hover { border-color: #2563eb; }
  .ot-page .mode-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -1;
