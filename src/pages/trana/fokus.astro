---
// Fokuserad träning på svagheter: tio uppgifter i taget från extramaterialet,
// per delprov, per uppgiftstyp eller viktat mot det användaren haft svårt för.
// Utan timer, med rättning och förklaring direkt efter varje svar. Utan
// historik börjar man med en snabbkoll över de vanligaste typerna.
import Base from '../../layouts/Base.astro';
import { getSessionFromCookies } from '../../lib/auth.js';
import { allaTyper, typVikter, DELPROV, DELPROV_NAMN, DELPROV_LANGT, typNamn } from '../../lib/fokus/fragebank.js';
import { hamtaHandelser, forStyrka } from '../../lib/fokus/historik.js';
import { beraknaStyrkor, svagasteTyper, prioritet, MINSTA_SVAR_SVAGHETER } from '../../lib/fokus/styrka.js';
import { byggKarta } from '../../lib/fokus/karta.js';
import { TEMPO_SEK } from '../../lib/fokus/typer.js';
import { formatAntal } from '../../lib/extraprov/register.js';
import Styrkekarta from '../../components/Styrkekarta.astro';
import '../../styles/fragor.css';

const user = await getSessionFromCookies(Astro.request.headers.get('cookie'));
const handelser = user ? await hamtaHandelser(user.id) : [];
const rakneBara = forStyrka(handelser);
const styrkor = beraknaStyrkor(rakneBara);
const typer = allaTyper(['extra']);
const totalt = typer.reduce((n, t) => n + t.antal, 0);

// Typrader: delprov som har undertyper (ORD och LÄS har bara sig själva).
// Typer under golvet ("övrigt") visas inte som chips, bara på kartan.
const typrader = DELPROV
  .map(dp => ({ dp, typer: typer.filter(t => t.delprov === dp && t.typ !== dp && !t.typ.endsWith(':ovrigt')) }))
  .filter(r => r.typer.length > 1);

const vikter = typVikter();
const harTillrackligt = rakneBara.length >= MINSTA_SVAR_SVAGHETER;
const svagaste = svagasteTyper(styrkor, 3, vikter, harTillrackligt);
const harSvagheter = harTillrackligt && svagaste.length > 0;
// Kartan sorteras som "Mina svagheter": mest att hämta först, osäkra sist.
const svagaTyper = new Set(svagaste.map(s => s.typ));
const karta = byggKarta(styrkor, typer)
  .map(r => ({ ...r, prio: styrkor.get(r.typ) ? prioritet(styrkor.get(r.typ)!, vikter.get(r.typ) ?? 1) : 0, etikett: svagaTyper.has(r.typ) ? 'mest att hämta' : '' }))
  .sort((a, b) => (a.osaker === b.osaker ? b.prio - a.prio : a.osaker ? 1 : -1));
const typNamnMap: Record<string, string> = Object.fromEntries(typer.map(t => [t.typ, t.namn]));
for (const dp of DELPROV) typNamnMap[dp] = DELPROV_NAMN[dp];
---

<Base title="Fokusera på dina svagheter – HPAkuten" description={`Träna på just de uppgiftstyper du behöver: välj delprov eller typ, eller låt verktyget välja utifrån dina svagheter. ${formatAntal(totalt)} uppgifter från tidigare högskoleprov med förklaring direkt efter varje svar.`}>
  <div class="page-content">
    <div class="container" style="max-width: 700px;">
      <div id="fokus-val">
        <h1>Fokusera på dina svagheter</h1>
        <p class="page-intro">Tio uppgifter i taget från tidigare högskoleprov, utan tid och med förklaring direkt efter varje svar. Jag väljer, du kör.</p>

        <section class="fokus-block fokus-block--svag">
          {harSvagheter ? (
            <Fragment>
              <h2>Mina svagheter</h2>
              <p>Mest att hämta just nu: <strong>{svagaste.map(s => typNamnMap[s.typ] || s.typ).join(', ')}</strong>. Jag blandar uppgifter från de typerna med lite annat insprängt, så att det inte blir ren drill.</p>
              <button class="btn btn-primary fokus-start" data-lage="svagheter" data-val="">Träna på mina svagheter</button>
            </Fragment>
          ) : (
            <Fragment>
              <h2>Börja med en snabbkoll</h2>
              <p>Tolv uppgifter över de vanligaste typerna. Sedan vet vi var du står och jag kan välja åt dig. Tar tio minuter.</p>
              <button class="btn btn-primary fokus-start" data-lage="snabbkoll" data-val="">Snabbkoll, cirka tio minuter</button>
              {rakneBara.length > 0 && <p style="margin:0.6rem 0 0; font-size:0.85rem;">Du har {rakneBara.length} svar hittills. Från {MINSTA_SVAR_SVAGHETER} svar kan jag välja dina svagheter åt dig.</p>}
            </Fragment>
          )}
        </section>

        <section class="fokus-block">
          <h2>Så här ligger du till</h2>
          {karta.length === 0 ? (
            <p>Här ser du hur det går per uppgiftstyp när du börjat träna. Både proven och rundorna här räknas.</p>
          ) : (
            <Fragment>
              <p>Andel rätt per uppgiftstyp, där nya svar väger mer än gamla. Jag räknar också hur vanlig typen är på provet, så det som ger mest att hämta ligger överst. Klicka på en rad för att träna på just den typen.</p>
              <Styrkekarta rader={karta} />
            </Fragment>
          )}
        </section>

        <section class="fokus-block">
          <h2>Ett delprov</h2>
          <p>Slumpade uppgifter ur alla {formatAntal(totalt)} i extramaterialet.</p>
          <div class="fokus-chips">
            {DELPROV.map(dp => (
              <button class="fokus-chip fokus-start" data-lage="delprov" data-val={dp} title={DELPROV_LANGT[dp]}>{DELPROV_NAMN[dp]}</button>
            ))}
          </div>
        </section>

        <details class="fokus-block fokus-details">
          <summary><h2>En uppgiftstyp</h2><span class="fokus-details-hint">Visa alla {typrader.reduce((n, r) => n + r.typer.length, 0)} typer</span></summary>
          <p>Mer specifikt: en kategori inom ett delprov.</p>
          {typrader.map(r => (
            <div class="fokus-typrad">
              <span class="fokus-typrad-label">{DELPROV_NAMN[r.dp]}</span>
              <div class="fokus-chips">
                {r.typer.map(t => (
                  <button class="fokus-chip fokus-chip--typ fokus-start" data-lage="typ" data-val={t.typ}>{typNamn(t.typ).replace(/^\S+ /, '')} <span class="fokus-chip-antal">{t.antal}</span></button>
                ))}
              </div>
            </div>
          ))}
        </details>

        {!user || user.is_guest ? (
          <div class="tip-box" style="font-size:0.9rem;">
            <strong>Tips:</strong> <a href="#" onclick="event.preventDefault(); window.openSignupModal();">Skapa ett gratis konto</a> så sparas din träning och dina styrkor följer med mellan enheter. Du kan träna utan konto också.
          </div>
        ) : null}
      </div>

      <div id="fokus-runda" style="display:none;"></div>
    </div>
  </div>

  <script define:vars={{ harSession: !!user, arGast: !!user?.is_guest, typNamnMap, tempo: TEMPO_SEK }}>
    window.__fokus = { harSession, arGast, typNamnMap, tempo };
  </script>

  <script>
    import { laddaKatex, renderTex, questionBodyHTML, lasTextHTML, dtkDiagramHTML, forklaringHTML, resultDetailHTML, bindZoom, bindFadeIn, bindLasToggle, LABELS } from '../../lib/fragor/render.js';
    import type { Fraga, Delprov } from '../../lib/fragor/render.js';
    import { rekommendationFor } from '../../lib/fokus/rekommendationer.js';

    interface KlientFraga extends Fraga {
      id: string;
      testId: string;
      delprov: string;
      typ: string;
      grupp: string | null;
      shortName: string;
      lasText?: { title: string; html: string };
    }
    interface Enhet { grupp: string | null; skal?: string | null; fragor: KlientFraga[] }
    interface StyrkaInfo { styrka: number; antal: number; effektivt: number; osaker: boolean }
    interface Runda {
      lage: string; val: string; rubrik: string; enheter: Enhet[]; antalFragor: number;
      styrkorFore: Record<string, StyrkaInfo | null>; sett: { antal: number; av: number } | null; nastaSvaga: string[];
    }
    interface Svar { fraga: KlientFraga; chosen: number | null; ratt: boolean; correct: number; explanation: string | null; videoId: string | null; timeMs: number }

    const fokus = (window as any).__fokus as { harSession: boolean; arGast: boolean; typNamnMap: Record<string, string>; tempo: Record<string, number> };
    const valRoot = document.getElementById('fokus-val')!;
    const root = document.getElementById('fokus-runda')!;
    const SPARAD = 'hp-fokus-runda';
    laddaKatex();

    // Allt som sätts in i HTML från servern eller adressen escapas.
    const esc = (v: unknown) => String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    const giltigtVal = (v: string) => /^[a-z0-9:]*$/.test(v);
    const giltigtFran = (v: string) => /^[a-z0-9-]*$/.test(v);

    let runda: Runda | null = null;
    let platta: KlientFraga[] = [];
    let idx = 0;
    let svar: Svar[] = [];
    let fran = '';
    let styrkorEfter: Record<string, StyrkaInfo> = {};
    let startTid = 0;
    let textOpen = true;
    let laddar = false;
    let rundaId = '';
    let sprangd = false;
    let ejSparat = false;
    let skalPerFraga: Record<string, string> = {};
    // Räknas upp vid varje ny fråga; ett svar som kommer in för en gammal fråga ignoreras.
    let fragaToken = 0;

    const namn = (typ: string) => fokus.typNamnMap[typ] || typ;
    const pct = (s: StyrkaInfo | null | undefined) => s && !s.osaker ? `${Math.round(s.styrka * 100)} %` : null;
    const fmtTid = (ms: number) => { const s = Math.round(ms / 1000); return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`; };

    function delprovFor(q: KlientFraga): Delprov {
      const texts: { title: string; html: string }[] = [];
      if (q.lasText) texts[q.textIndex ?? 0] = q.lasText;
      return { id: q.delprov, shortName: q.shortName, type: q.delprov, texts: texts.length ? texts : undefined };
    }

    async function sakraSession() {
      if (fokus.harSession) return;
      try {
        const r = await fetch('/api/auth/guest', { method: 'POST' }).then(x => x.json());
        if (r && r.ok) { fokus.harSession = true; fokus.arGast = !!r.guest; }
      } catch {}
    }

    function sparaRunda() {
      try {
        if (!runda) { localStorage.removeItem(SPARAD); return; }
        localStorage.setItem(SPARAD, JSON.stringify({ runda, platta, idx, svar, fran, styrkorEfter, textOpen, rundaId, sprangd, skalPerFraga, tid: Date.now() }));
      } catch {}
    }

    function lasSparad(): boolean {
      try {
        const raw = localStorage.getItem(SPARAD);
        if (!raw) return false;
        const d = JSON.parse(raw);
        // Bara en färsk runda (under två timmar) återupptas.
        if (!d?.runda || !Array.isArray(d.platta) || !d.platta.length || d.idx >= d.platta.length || !d.tid || Date.now() - d.tid > 2 * 3600 * 1000) { localStorage.removeItem(SPARAD); return false; }
        runda = d.runda; platta = d.platta; idx = d.idx; svar = d.svar || []; fran = d.fran || ''; styrkorEfter = d.styrkorEfter || {}; textOpen = d.textOpen ?? true;
        rundaId = d.rundaId || ''; sprangd = !!d.sprangd; skalPerFraga = d.skalPerFraga || {};
        return true;
      } catch { return false; }
    }

    function visaRunda() {
      valRoot.style.display = 'none';
      root.style.display = 'block';
    }

    async function startaRunda(lage: string, val: string, antal = 0, franIn = '') {
      if (laddar) return;
      if (!giltigtVal(val)) val = '';
      laddar = true;
      visaRunda();
      root.innerHTML = '<p style="text-align:center; color:var(--color-muted); padding:3rem 0;">Väljer uppgifter …</p>';
      window.scrollTo({ top: 0 });
      await sakraSession();
      try {
        const res = await fetch(`/api/fokus/runda?lage=${encodeURIComponent(lage)}&val=${encodeURIComponent(val)}${antal ? `&antal=${antal}` : ''}`);
        const data = await res.json();
        if (!res.ok || data.error) throw new Error(data.error || 'fel');
        runda = data;
        platta = data.enheter.flatMap((e: Enhet) => e.fragor);
        skalPerFraga = {};
        for (const e of data.enheter as Enhet[]) if (e.skal) for (const q of e.fragor) skalPerFraga[q.id] = e.skal;
        idx = 0;
        svar = [];
        fran = giltigtFran(franIn) ? franIn : '';
        styrkorEfter = {};
        textOpen = true;
        sprangd = false;
        ejSparat = false;
        rundaId = (crypto as any).randomUUID ? crypto.randomUUID() : String(Date.now());
        const url = new URL(window.location.href);
        url.search = '';
        url.searchParams.set('lage', lage);
        if (val) url.searchParams.set('val', val);
        history.replaceState(null, '', url.toString());
        sparaRunda();
        renderFraga();
      } catch (e: any) {
        const kod = e?.message;
        const msg = kod === 'ingen_historik'
          ? 'Jag vet inte vad du har svårt för ännu. Gör snabbkollen eller ett prov först, sedan kan jag välja åt dig.'
          : ['okand_typ', 'okant_delprov', 'okant_lage', 'tomt_urval'].includes(kod)
            ? 'Den här länken pekar på en uppgiftstyp som inte finns. Välj något i listan i stället.'
            : 'Det gick inte att hämta uppgifter just nu. Prova igen om en stund.';
        runda = null;
        sparaRunda();
        root.style.display = 'none';
        valRoot.style.display = 'block';
        valRoot.insertAdjacentHTML('afterbegin', `<div class="tip-box warning" id="fokus-felruta">${msg}</div>`);
        history.replaceState(null, '', window.location.pathname);
      }
      laddar = false;
    }

    function tillbaka() {
      // Laddar om sidan så att styrkekartan visar de nya svaren.
      runda = null;
      sparaRunda();
      window.location.href = window.location.pathname;
    }

    function rundaRubrik(): string {
      return runda!.lage === 'snabbkoll' ? `Snabbkoll · ${platta.length} uppgifter` : runda!.rubrik;
    }

    /** Varför just den här uppgiften kom, i Mina svagheter. */
    function skalText(q: KlientFraga): string {
      const skal = skalPerFraga[q.id];
      if (!skal) return '';
      const t: Record<string, string> = {
        svag: `${namn(q.typ)}, en av de typer som ger dig mest att hämta`,
        fler: `${namn(q.typ)}, som du bad om fler av`,
        repetera: 'Den här hade du fel på för ett tag sedan',
        blandning: `${namn(q.typ)}, insprängd för variation`,
        avslutning: `${namn(q.typ)}, en stark typ att avsluta med`,
      };
      return t[skal] ? `<p class="fokus-sett">${esc(t[skal])}</p>` : '';
    }

    function renderFraga() {
      const q = platta[idx];
      const st = delprovFor(q);
      const grupp = q.grupp;
      const iGrupp = grupp ? platta.filter(x => x.grupp === grupp) : [];
      const gruppText = iGrupp.length > 1 ? ` · ${q.delprov === 'las' ? 'texten' : 'diagrammet'} har ${iGrupp.length} frågor` : '';
      const sett = runda!.sett;
      const settText = idx === 0 && sett && (sett.antal > 0 || sett.av < 30)
        ? `<p class="fokus-sett">${sett.av} uppgifter av den här sorten finns, du har sett ${sett.antal}${sett.antal >= sett.av ? '. Nu kommer de du sett längst tillbaka igen' : ''}.</p>`
        : '';
      root.innerHTML = `
        <div class="prov-top-bar">
          <span class="prov-section-tag">${esc(rundaRubrik())}</span>
          <button class="btn-timer-toggle" id="btn-avbryt" title="Avsluta rundan" aria-label="Avsluta rundan">✕</button>
        </div>
        <div class="pq-progress">Uppgift ${idx + 1} av ${platta.length}${gruppText}</div>
        ${settText}${skalText(q)}
        ${dtkDiagramHTML(q, st)}
        ${lasTextHTML(q, st, textOpen)}
        <div class="pq-card">
          ${questionBodyHTML(q, st)}
          <div class="pq-options">
            ${q.options.map((opt, i) => `
              <button class="pq-opt" data-oi="${i}" type="button">
                <span class="pq-letter">${LABELS[i]}</span>
                <span class="pq-opt-text">${opt}</span>
              </button>
            `).join('')}
          </div>
          <div id="fokus-fb"></div>
        </div>
        <div class="pq-nav fokus-nav" id="fokus-nav">
          <button class="btn btn-outline btn-sm" id="btn-hoppa" type="button">Vet inte, visa svaret</button>
        </div>
      `;
      startTid = performance.now();
      fragaToken++;
      root.querySelectorAll('.pq-opt').forEach(el => {
        el.addEventListener('click', () => besvara(Number(el.getAttribute('data-oi'))));
      });
      document.getElementById('btn-hoppa')?.addEventListener('click', () => besvara(null));
      document.getElementById('btn-avbryt')?.addEventListener('click', () => {
        if (svar.length === 0) { tillbaka(); return; }
        if (confirm('Vill du avsluta rundan? Svaren du gett är sparade.')) renderSammanfattning();
      });
      bindLasToggle(root, open => { textOpen = open; sparaRunda(); });
      bindZoom(root);
      bindFadeIn(root);
      renderTex();
    }

    async function besvara(chosen: number | null) {
      const q = platta[idx];
      const minToken = fragaToken;
      const timeMs = Math.round(performance.now() - startTid);
      // Lås alternativen direkt så att dubbelklick inte ger två svar.
      root.querySelectorAll('.pq-opt').forEach(el => { el.classList.add('pq-opt--klar'); (el as HTMLButtonElement).disabled = true; });
      const hoppa = document.getElementById('btn-hoppa') as HTMLButtonElement | null;
      if (hoppa) hoppa.style.display = 'none';
      let data: any = null;
      try {
        const res = await fetch('/api/fokus/svar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ questionId: q.id, chosen, timeMs, lage: runda?.lage, rundaId }),
        });
        data = await res.json();
      } catch {}
      // Rundan kan ha avslutats eller bytt fråga medan svaret var på väg.
      if (minToken !== fragaToken || !document.getElementById('fokus-fb')) return;
      if (!data || data.error) {
        document.getElementById('fokus-fb')!.innerHTML = '<div class="tip-box warning" style="margin:1rem 0 0;">Kunde inte rätta just nu. Prova igen.</div>';
        root.querySelectorAll('.pq-opt').forEach(el => { el.classList.remove('pq-opt--klar'); (el as HTMLButtonElement).disabled = false; });
        if (hoppa) hoppa.style.display = '';
        return;
      }
      const ratt = !!data.ratt;
      svar.push({ fraga: q, chosen, ratt, correct: data.correct, explanation: data.explanation, videoId: data.videoId, timeMs });
      if (data.styrkaEfter) styrkorEfter[data.styrkaEfter.typ] = data.styrkaEfter;
      if (data.sparad === false) ejSparat = true;
      sparaRunda();
      root.querySelectorAll('.pq-opt').forEach(el => {
        const oi = Number(el.getAttribute('data-oi'));
        if (oi === data.correct) el.classList.add('pq-opt--ratt');
        else if (oi === chosen) el.classList.add('pq-opt--fel');
      });
      const rubrik = ratt
        ? '<strong>Rätt!</strong>'
        : chosen === null
          ? `<strong>Rätt svar är ${LABELS[data.correct]}.</strong>`
          : `<strong>Inte rätt den här gången.</strong> Rätt svar är ${LABELS[data.correct]}.`;
      const sista = idx === platta.length - 1;
      document.getElementById('fokus-fb')!.innerHTML = `
        <div class="fokus-fb ${ratt ? 'fokus-fb--ok' : 'fokus-fb--no'}" role="status">${rubrik}</div>
        ${forklaringHTML({ ...q, explanation: data.explanation || undefined, videoId: data.videoId || undefined })}
      `;
      // Högst en insprängning per runda, och bara utanför läge typ.
      const kanSpranga = !ratt && runda!.lage !== 'typ' && !sprangd;
      document.getElementById('fokus-nav')!.innerHTML = `
        <span class="fokus-nav-status">${svar.filter(s => s.ratt).length} rätt av ${svar.length}</span>
        ${kanSpranga ? `<button class="btn btn-outline btn-sm" id="btn-fler" type="button">Fler av den här typen</button>` : ''}
        <button class="btn btn-primary" id="btn-nasta" type="button">${sista ? 'Visa resultat' : 'Nästa'}</button>
      `;
      document.getElementById('fokus-nav')!.classList.add('fokus-nav--sticky');
      const nasta = document.getElementById('btn-nasta')!;
      nasta.addEventListener('click', () => { if (idx === platta.length - 1) renderSammanfattning(); else { idx++; sparaRunda(); renderFraga(); window.scrollTo({ top: 0 }); } });
      document.getElementById('btn-fler')?.addEventListener('click', () => sprangIn(q.typ));
      nasta.focus({ preventScroll: true });
      renderTex();
    }

    /** Skjuter in tre uppgifter av samma typ lite längre fram i rundan (efter
     * två andra uppgifter), så att rundan inte blir ren drill. En gång per runda. */
    async function sprangIn(typ: string) {
      const knapp = document.getElementById('btn-fler') as HTMLButtonElement | null;
      if (knapp) { knapp.disabled = true; knapp.textContent = 'Hämtar …'; }
      try {
        const utom = platta.map(q => q.id).join(',');
        const res = await fetch(`/api/fokus/runda?lage=typ&val=${encodeURIComponent(typ)}&antal=3&utom=${encodeURIComponent(utom)}`);
        const data = await res.json();
        if (!res.ok || data.error) throw new Error(data.error || 'fel');
        const nya: KlientFraga[] = data.enheter.flatMap((e: Enhet) => e.fragor);
        const plats = Math.min(platta.length, idx + 3);
        platta.splice(plats, 0, ...nya);
        for (const q of nya) skalPerFraga[q.id] = 'fler';
        for (const [t, s] of Object.entries(data.styrkorFore || {})) if (!(t in runda!.styrkorFore)) runda!.styrkorFore[t] = s as StyrkaInfo | null;
        sprangd = true;
        sparaRunda();
        if (knapp) knapp.replaceWith(Object.assign(document.createElement('span'), { className: 'fokus-nav-status', textContent: `${nya.length} till av ${namn(typ)} kommer strax` }));
      } catch {
        if (knapp) { knapp.disabled = false; knapp.textContent = 'Fler av den här typen'; }
      }
    }

    function renderSammanfattning() {
      fragaToken++;
      const antalRatt = svar.filter(s => s.ratt).length;
      const perTyp = new Map<string, { ratt: number; antal: number }>();
      for (const s of svar) {
        const t = perTyp.get(s.fraga.typ) || { ratt: 0, antal: 0 };
        t.antal++;
        if (s.ratt) t.ratt++;
        perTyp.set(s.fraga.typ, t);
      }
      const typRader = [...perTyp.entries()].sort((a, b) => a[1].ratt / a[1].antal - b[1].ratt / b[1].antal);
      const allaRatt = antalRatt === svar.length;
      const andel = antalRatt / Math.max(1, svar.length);
      const ton = allaRatt
        ? `Snyggt! ${antalRatt} av ${svar.length}. Byt typ, det här kan du.`
        : andel >= 0.7
          ? 'Bra jobbat! Kör en runda till så ser du om det sitter.'
          : 'Inget fel att ha fel, det är så man lär sig. Läs förklaringarna nedan och kör en runda till.';
      const totalMs = svar.reduce((a, s) => a + s.timeMs, 0);
      const tempoMs = svar.reduce((a, s) => a + (fokus.tempo[s.fraga.delprov] || 60) * 1000, 0);
      const tidText = `Du tog ${fmtTid(totalMs)} på ${svar.length} uppgifter, på provet har du cirka ${fmtTid(tempoMs)}.`;
      // Styrkan före och efter per typ, där det finns siffror.
      const styrkeRader = typRader.map(([typ]) => {
        const fore = runda!.styrkorFore[typ];
        const efter = styrkorEfter[typ] || styrkorEfter[Object.keys(styrkorEfter).find(k => k === typ) || ''];
        if (!efter) return '';
        const foreText = pct(fore) || (fore ? `för lite data (${fore.antal} svar)` : 'inga svar än');
        const efterText = pct(efter) ? `${pct(efter)} (${efter.antal} svar)` : `för lite data (${efter.antal} svar)`;
        return `<button class="fokus-sammanf-rad fokus-start" data-lage="typ" data-val="${esc(typ)}" type="button"><span>${esc(namn(efter.typ || typ))}</span><span class="fokus-sammanf-varde">${foreText} → ${efterText}</span></button>`;
      }).filter(Boolean).join('');
      // Genomgångar för den typ som gick sämst, bara när något blev fel.
      const svagastTyp = typRader.find(([, t]) => t.ratt < t.antal)?.[0];
      const rek = svagastTyp ? rekommendationFor(svagastTyp) : null;
      const rekHTML = rek ? `<div class="fokus-rek">
          <p class="fokus-rek-label">Vill du ha hjälp med ${esc(namn(svagastTyp!))}?</p>
          <div class="fokus-rek-lankar">
            <a href="${esc(rek.strategi.url)}">${esc(rek.strategi.namn)}</a>
            ${rek.matte.map(m => `<a href="${esc(m.url)}">Matterepetition: ${esc(m.namn)}</a>`).join('')}
          </div>
        </div>` : '';
      // Högst två knappar: en primär och en sekundär.
      const nasta = (runda!.nastaSvaga || []).find(t => t !== runda!.val);
      const arSnabbkoll = runda!.lage === 'snabbkoll';
      const primar = arSnabbkoll
        ? `<button class="btn btn-primary fokus-start" data-lage="svagheter" data-val="" type="button">Träna på mina svagheter</button>`
        : `<button class="btn btn-primary fokus-start" data-lage="${esc(runda!.lage)}" data-val="${esc(runda!.val || '')}" type="button">Kör tio till</button>`;
      const sekundar = fran
        ? `<a class="btn btn-outline" href="${fran.startsWith('extra-') ? `/extra/${esc(fran.slice(6))}?review=1` : `/prov/${esc(fran)}?review=1`}">Tillbaka till rättningen</a>`
        : nasta && !arSnabbkoll
          ? `<button class="btn btn-outline fokus-start" data-lage="typ" data-val="${esc(nasta)}" type="button">Byt till ${esc(namn(nasta))}</button>`
          : '';
      const ordLank = svar.some(s => s.fraga.delprov === 'ord')
        ? '<p style="text-align:center; font-size:0.9rem;">Vill du bygga ordförrådet på riktigt? <a href="/ord">Kör ordträningen</a>, den kommer ihåg vilka ord du missar.</p>'
        : '';
      const felTyper = typRader.filter(([, t]) => t.ratt < t.antal).map(([typ]) => namn(typ));
      const snabbkollText = arSnabbkoll
        ? `<p style="text-align:center; font-size:0.9rem;">${felTyper.length ? `Du hade fel på ${esc(felTyper.join(', '))}. Börja där. ` : 'Bra start. '}Nästa gång kan du trycka på <strong>Träna på mina svagheter</strong>, så väljer jag åt dig.</p>`
        : '';
      const ejSparatText = ejSparat
        ? '<div class="tip-box warning" style="font-size:0.9rem;">Svaren kunde inte sparas den här gången, så kartan uppdateras inte. Kolla att webbläsaren tillåter kakor.</div>'
        : '';
      root.innerHTML = `
        <div class="pq-result-head">
          <h2>Klart!</h2>
          <div class="pq-score">${antalRatt}/${svar.length}</div>
          <p style="color:var(--color-muted)">rätt · ${esc(rundaRubrik())}</p>
          <p>${ton}</p>
          <p style="font-size:0.85rem; color:var(--color-muted);">${tidText}</p>
        </div>
        ${ejSparatText}
        ${styrkeRader ? `<div class="fokus-sammanf-typer">${styrkeRader}</div>` : ''}
        ${snabbkollText}
        <div class="fokus-knappar">
          ${primar}
          ${sekundar}
          <button class="btn-overview-link" id="btn-valj" type="button">Välj något annat</button>
        </div>
        ${rekHTML}
        ${ordLank}
        ${fokus.arGast || !fokus.harSession ? '<div class="tip-box" style="font-size:0.9rem;"><strong>Tips:</strong> <a href="#" onclick="event.preventDefault(); window.openSignupModal();">Skapa ett gratis konto</a> så sparas din träning permanent och dina styrkor följer med mellan enheter.</div>' : ''}
        <h3 style="margin:2rem 0 0.5rem;">Uppgifterna i rundan</h3>
        <p style="font-size:0.85rem; color:var(--color-muted); margin-bottom:0.8rem;">Klicka på en uppgift för att se den och förklaringen igen.</p>
        <div class="pq-results">${svar.map((s, i) => `<div class="pq-res-wrap">
          <button class="pq-res ${s.ratt ? 'pq-res--ok' : 'pq-res--no'}" data-toggle="fres-${i}" type="button" aria-expanded="false" aria-controls="fres-${i}">
            <span class="pq-res-icon" aria-label="${s.ratt ? 'Rätt' : 'Fel'}">${s.ratt ? '✓' : '✗'}</span>
            <span class="pq-res-num">${i + 1}.</span>
            <span>${esc(namn(s.fraga.typ))}</span>
            ${!s.ratt ? `<span class="pq-res-right">Rätt: <b>${LABELS[s.correct]}</b></span>` : ''}
            <span class="pq-res-chevron" aria-hidden="true">▾</span>
          </button>
          <div class="pq-res-detail" id="fres-${i}" style="display:none;">${resultDetailHTML({ ...s.fraga, correct: s.correct, explanation: s.explanation || undefined, videoId: s.videoId || undefined }, delprovFor(s.fraga), s.chosen)}</div>
        </div>`).join('')}</div>
      `;
      root.querySelectorAll('[data-toggle]').forEach(el => {
        el.addEventListener('click', () => {
          const detail = document.getElementById(el.getAttribute('data-toggle')!);
          if (!detail) return;
          const open = detail.style.display !== 'none';
          detail.style.display = open ? 'none' : 'block';
          el.setAttribute('aria-expanded', open ? 'false' : 'true');
          el.querySelector('.pq-res-chevron')!.textContent = open ? '▾' : '▴';
          if (!open) renderTex();
        });
      });
      document.getElementById('btn-valj')?.addEventListener('click', tillbaka);
      runda = null;
      sparaRunda();
      bindStart(root);
      renderTex();
      window.scrollTo({ top: 0 });
    }

    function bindStart(scope: ParentNode) {
      scope.querySelectorAll<HTMLElement>('.fokus-start').forEach(btn => {
        btn.addEventListener('click', () => startaRunda(btn.dataset.lage || 'delprov', btn.dataset.val || ''));
      });
    }
    bindStart(valRoot);

    // Direktlänk från rättningen: /trana/fokus?lage=typ&val=xyz:algebra&fran=extra-ht2019-1
    const params = new URLSearchParams(window.location.search);
    const lage = params.get('lage');
    if (lage === 'delprov' || lage === 'typ' || lage === 'svagheter' || lage === 'snabbkoll') {
      startaRunda(lage, params.get('val') || '', Number(params.get('antal') || 0), params.get('fran') || '');
    } else if (lasSparad()) {
      // En påbörjad runda återupptas där den var.
      visaRunda();
      renderFraga();
    }
  </script>
</Base>

