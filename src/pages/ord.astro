  .ot-page .rt-nav { display: flex; justify-content: space-between; gap: 0.5rem; margin-top: 0.8rem; }
  .ot-page .rt-nav button { font: inherit; font-size: 0.85rem; font-weight: 600; color: #64748b; background: #fff;
    border: 1.5px solid #e2e8f0; border-radius: 8px; padding: 0.45rem 0.85rem; cursor: pointer; }
  .ot-page .rt-nav button:hover { border-color: #2563eb; color: #2563eb; }
  .ot-page .rt-nav .spacer { flex: 1; }

  .ot-page .wl-search { font: inherit; width: 100%; box-sizing: border-box; padding: 0.6rem 0.85rem;
