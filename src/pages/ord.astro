  .ot-page .wl-search:focus { outline: none; border-color: #2563eb; }
  .ot-page .wl-list { display: flex; flex-direction: column; gap: 0.35rem; }
  .ot-page .wl-item { border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden;
    content-visibility: auto; contain-intrinsic-size: auto 44px; }
  .ot-page .wl-row { font: inherit; width: 100%; display: flex; align-items: baseline; gap: 0.55rem;
    padding: 0.55rem 0.8rem; background: #fff; border: none; cursor: pointer; text-align: left; }
  .ot-page .wl-row:hover { background: #f8fafc; }
  .ot-page .wl-row b { color: #1a1a2e; white-space: nowrap; }
  .ot-page .wl-def { color: #64748b; font-size: 0.85rem; flex: 1; min-width: 0; overflow: hidden;
    text-overflow: ellipsis; white-space: nowrap; }
  .ot-page .wl-loading { margin: 0; font-size: 0.85rem; color: #94a3b8; }

  .ot-page .reset-line { text-align: center; margin: 1rem 0 0; }
  .ot-page .link-btn { background: none; border: none; color: #94a3b8; font: inherit; font-size: 0.82rem; cursor: pointer; text-decoration: underline; }
  .ot-page .link-btn:hover { color: #ef4444; }
  .ot-page .ety { border-left: 3px solid #e2e8f0; padding: 0.15rem 0 0.15rem 0.8rem; margin: 0 0 0.2rem; font-size: 0.9rem; color: #64748b; }
  .ot-page .ety-label { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #94a3b8; display: block; margin-bottom: 0.15rem; }
  .ot-page .ety-none { color: #cbd5e1; }
  .ot-page #fb .ety { margin-bottom: 0.7rem; }

  .ot-page .q-label { font-size: 0.85rem; color: #64748b; margin: 0 0 0.2rem; text-align: center; }
  .ot-page .opts { display: flex; flex-direction: column; gap: 0.5rem; margin: 0.6rem 0 0.4rem; }
  .ot-page .opt { display: flex; align-items: center; gap: 0.7rem; font: inherit; font-size: 0.98rem; text-align: left; width: 100%;
    padding: 0.7rem 0.8rem; background: #fff; border: 2px solid #e2e8f0; border-radius: 10px; cursor: pointer; color: #1a1a2e; }
  .ot-page .opts:not(.answered) .opt:hover { border-color: #2563eb; }
  .ot-page .opt.dim { opacity: 0.5; }
  .ot-page .opts.answered .opt { cursor: pointer; }
  .ot-page .next-arrow { margin-left: auto; font-weight: 800; font-size: 1.15rem; line-height: 1; animation: ot-nudge 0.9s ease-in-out infinite; }
  @keyframes ot-nudge { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(4px); } }
  @media (prefers-reduced-motion: reduce) { .ot-page .next-arrow { animation: none; } }
  .ot-page .opt .letter { width: 28px; height: 28px; border-radius: 50%; background: #f1f5f9; border: 1.5px solid #e2e8f0;
    display: grid; place-items: center; font-weight: 700; font-size: 0.8rem; flex-shrink: 0; }
  .ot-page .opt.correct { border-color: #10b981; background: #d1fae5; } .ot-page .opt.correct .letter { background: #10b981; border-color: #10b981; color: #fff; }
  .ot-page .opt.wrong { border-color: #ef4444; background: #fee2e2; } .ot-page .opt.wrong .letter { background: #ef4444; border-color: #ef4444; color: #fff; }
  .ot-page .opt:disabled { cursor: default; } .ot-page .opt:disabled:not(.correct):not(.wrong):not(.chosen) { opacity: 0.5; }
  .ot-page .verdict { font-weight: 700; margin: 0.4rem 0 0.6rem; } .ot-page .verdict.ok { color: #047857; } .ot-page .verdict.no { color: #ef4444; }
  .ot-page .when-chip { font-size: 0.78rem; font-weight: 600; color: #047857; background: #ecfdf5;
    border: 1px solid #a7f3d0; border-radius: 999px; padding: 0.15rem 0.6rem; margin-left: 0.3rem; }
  .ot-page .peek { font: inherit; font-size: 0.82rem; font-weight: 600; color: #64748b; background: none;
    border: 1.5px solid #e2e8f0; border-radius: 8px; padding: 0.4rem 0.8rem; cursor: pointer; margin-bottom: 0.6rem; }
  .ot-page .peek:hover { border-color: #2563eb; color: #2563eb; }
  .ot-page .peek.is-open { border-color: #2563eb; color: #2563eb; background: #eff6ff; }
  .ot-page .fb-img { display: block; width: 96px; height: 96px; object-fit: contain; border: 1px solid #e2e8f0; border-radius: 12px; padding: 5px; margin: 0.2rem auto 0.5rem; }

  .ot-page .done-head { text-align: center; margin: 0.4rem 0 1.1rem; }
  .ot-page .done-head .big { font-size: 2.6rem; font-weight: 800; color: #2563eb; font-variant-numeric: tabular-nums; line-height: 1.1; }
  .ot-page .done-head .sub { color: #64748b; font-size: 0.9rem; }
  .ot-page .done-list { display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 1.1rem; max-height: 320px; overflow-y: auto; }
  .ot-page .done-row { display: flex; align-items: center; gap: 0.6rem; font-size: 0.9rem; padding: 0.45rem 0.7rem; border-radius: 8px; background: #f8fafc; }
  .ot-page .done-row .mark { font-weight: 700; width: 1.2rem; text-align: center; } .ot-page .done-row.ok .mark { color: #10b981; } .ot-page .done-row.rep .mark { color: #b45309; }
  .ot-page .done-row .when { margin-left: auto; font-size: 0.78rem; color: #64748b; }
  .ot-page .empty { text-align: center; color: #64748b; padding: 1.5rem 0.5rem; }
  .ot-page .empty .big { font-size: 2.2rem; }
</style>

<script is:inline>
  // Spaced repetition-rutan ligger utanför appen och ska funka även utloggad.
  document.getElementById('sr-info-toggle').onclick = () => {
    const body = document.getElementById('sr-info-body');
    body.hidden = !body.hidden;
  };
</script>

<script is:inline define:vars={{ EXAMS: exams, HAS_SESSION: !!user, IS_GUEST: !!user?.is_guest, TOTAL_WORDS: wordCount.n }}>
(function () {
  const app = document.getElementById('app');
  if (!app) return; // utloggad besökare ser landningsvyn i stället
  const devMsg = document.getElementById('dev-msg');
  let session = [], stats = null, learnI = 0, quizI = 0, results = [];
  // Utan session körs sidan i gästläge: startvyn visas direkt och ett osynligt
  // gästkonto skapas först när besökaren börjar träna eller öppnar ett läge.
  let hasSession = HAS_SESSION, isGuest = IS_GUEST;
  let settings = { newPer: 10, reviewPer: 100 };
  let settingsOpen = false;
  let newLeft = 0;
  let streak = 0, trainedToday = false, ignoredWords = [];
  let startLevel = 1; // nivån när vyn laddades, för att upptäcka nivåbyten
  const INTERVAL_DAYS = { 1: 1, 2: 3, 3: 7, 4: 16, 5: 35, 6: 90 };
  let quizQueue = [], quizTotal = 0, resultsMap = {};

  function relatedHtml(rel) {
    const has = !!(rel && rel.words && rel.words.length);
    const items = has
      ? rel.words.map(r => `<span class="rel-item"><b>${esc(r.word)}</b>${r.gloss ? ` <i>${esc(r.gloss)}</i>` : ''}</span>`).join('')
      : '<span class="rel-item rel-none">—</span>';
    const label = 'Ord med samma rot' + (has && rel.root ? ': ' + esc(rel.root) : '');
    return `<div class="rel"><span class="rel-label">${label}</span><div class="rel-words">${items}</div></div>`;
  }

  function shuffle(arr) {
    const a = arr.slice();
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  function esc(s) { return (s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;'); }
  function hooks(s) { return esc(s).replace(/([A-ZÅÄÖ]{2,})/g, '<span class="hook">$1</span>'); }
  // Ringen sveps upp med animerade vinklar. Kräver registrerade custom properties;
  // saknas de (eller vill användaren ha mindre rörelse) ritas ringen statiskt.
  function regAngle(name) {
    try {
      CSS.registerProperty({ name, syntax: '<angle>', initialValue: '0deg', inherits: false });
      return true;
    } catch {
      // Redan registrerad räknas som ok, saknat stöd gör det inte.
      return typeof CSS !== 'undefined' && !!CSS.registerProperty;
    }
  }
  const sweepOk = regAngle('--ot-deg') && regAngle('--ot-track');
  const calmMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Två lager: den grå banan underst och den blå andelen ovanpå. Båda ritas
  // medsols från toppen, så den grå banan springer före och den blå fylls i
  // efter den.
  function ringLayers(blue, track) {
    return `background: conic-gradient(#2563eb 0 ${blue}, transparent ${blue} 360deg),`
      + ` conic-gradient(#e2e8f0 0 ${track}, transparent ${track} 360deg);`;
  }
  function ring(pct) {
    const deg = Math.max(4, Math.round(pct * 3.6));
    if (!sweepOk || calmMotion) {
      return `class="ring" style="${ringLayers(deg + 'deg', '360deg')}"`;
    }
    return `class="ring ring--sweep" style="--ot-goal:${deg}deg; ${ringLayers('var(--ot-deg)', 'var(--ot-track)')}"`;
  }
  // Nivåtrappa för ansiktet i ringen. Stegen växer så att det går snabbt i
  // början och kräver mer och mer längre fram. Sista nivån kräver alla ord.
  const FACE_STEPS = [0, 30, 100, 220, 420, 720, 1150, 2000, 3000];
  function faceLevel(learned, total) {
    if (total > 0 && learned >= total) return FACE_STEPS.length + 1;
    let lvl = 1;
    for (let i = 0; i < FACE_STEPS.length; i++) if (learned >= FACE_STEPS[i]) lvl = i + 1;
    return Math.min(lvl, FACE_STEPS.length);
  }
  function faceHtml(learned, total) {
    const lvl = faceLevel(learned, total);
    return `<img class="face is-in" id="face" src="/ordfejs/${lvl}.webp" width="146" height="146"
      alt="Nivå ${lvl} av ${FACE_STEPS.length + 1}" title="Nivå ${lvl} av ${FACE_STEPS.length + 1}">`;
  }
  function bindFace() {
    const face = document.getElementById('face');
    if (!face) return;
    face.addEventListener('animationend', e => {
      if (e.animationName === 'ot-face-in') face.classList.remove('is-in');
    });
    face.onclick = () => {
      face.classList.remove('is-in', 'is-bounce');
      void face.offsetWidth; // tvinga omstart av animationen vid upprepade klick
      face.classList.add('is-bounce');
    };
  }
  function whenLabel(days) {
    if (days <= 0) return 'senare idag';
    if (days === 1) return 'imorgon';
    if (days < 7) return 'om ' + days + ' dagar';
    if (days < 30) return 'om ' + Math.round(days / 7) + ' veckor';
    return 'om ' + Math.round(days / 30) + ' månader';
  }

  async function api(method, body) {
    const opts = { method, headers: { 'Content-Type': 'application/json' } };
    if (body) opts.body = JSON.stringify(body);
    const url = method === 'GET' ? '/api/ordtraning?action=session' : '/api/ordtraning';
    const r = await fetch(url, opts);
    return r.json();
  }

  async function ensureSession() {
    if (hasSession) return;
    const r = await fetch('/api/auth/guest', { method: 'POST' }).then(x => x.json()).catch(() => null);
    if (r && r.ok) { hasSession = true; isGuest = !!r.guest; }
  }

  async function load() {
    if (!hasSession) {
      // Gäst utan konto ännu: visa startvyn med nollställd statistik.
      stats = { total: TOTAL_WORDS, learned: 0, strong: 0, due: 0, today: 0, ignored: 0 };
      session = []; newLeft = settings.newPer; streak = 0; trainedToday = false; ignoredWords = [];
      startLevel = 1;
      learnI = 0; quizI = 0; results = []; quizQueue = []; quizTotal = 0; resultsMap = {};
      renderStart();
      return;
    }
    app.innerHTML = '<div class="loading">Laddar…</div>';
    const data = await api('GET');
    session = data.session || [];
    stats = data.stats;
    newLeft = data.newLeft || 0;
    streak = data.streak || 0;
    trainedToday = !!data.trainedToday;
    ignoredWords = data.ignoredWords || [];
    startLevel = faceLevel(stats.learned, stats.total);
    if (data.settings) settings = data.settings;
    learnI = 0; quizI = 0; results = []; quizQueue = []; quizTotal = 0; resultsMap = {};
    renderStart();
  }

  // Diskret kontouppmuntran för gäster. Visas i lägena tills den avfärdats.
  function guestNudgeHtml() {
    if (!isGuest) return '';
    let done = null;
    try { done = localStorage.getItem('ot-nudge-done'); } catch {}
    if (done) return '';
    return `<div class="gnudge" id="gnudge">
      <p><b>Tips!</b> Skapa ett gratis konto så sparas dina framsteg och följer med mellan mobilen och datorn.</p>
      <div class="gnudge-row">
        <a class="btn btn-primary gnudge-btn" href="/konto/registrera?next=/ord">Skapa gratis konto</a>
        <button class="link-btn" id="gnudge-skip" type="button">Fortsätt utan konto</button>
      </div></div>`;
  }
  function bindGuestNudge() {
    const skip = document.getElementById('gnudge-skip');
    if (skip) skip.onclick = () => {
      try { localStorage.setItem('ot-nudge-done', '1'); } catch {}
      const el = document.getElementById('gnudge');
      if (el) el.remove();
    };
  }

  function frame(tag, step, pct, inner, back) {
    const backBtn = back
      ? `<button class="back-btn" id="back" type="button" title="${esc(back)}" aria-label="${esc(back)}">‹</button>`
      : '';
    return `<div class="card">
      <div class="card-top"><span class="top-left">${backBtn}<span class="tag">${tag}</span></span><span class="step">${step}</span></div>
      <div class="bar"><i style="width:${pct}%"></i></div>
      <div class="body">${inner}</div></div>`;
  }

  // Hur många ord man hinner till kommande prov om man håller dagens tempo.
  const nf = n => n.toLocaleString('sv-SE');
  function calcInner() {
    const per = settings.newPer;
    const rows = EXAMS.map(e => {
      const days = Math.max(0, Math.ceil((new Date(e.date + 'T09:00:00') - new Date()) / 86400000));
      const reach = Math.min(stats.total, stats.learned + per * days);
      const all = reach >= stats.total;
      return `<div class="calc-row"><span class="calc-n">${all ? 'hela listan' : nf(reach) + ' ord'}</span>`
        + ` till provet ${esc(e.label)}${e.prel ? ' <span class="calc-prel">(prel.)</span>' : ''}`
        + ` <span class="calc-prel">(${nf(days)} dagar)</span></div>`;
    }).join('');
    return `<div class="calc-head">Med <b>${per}</b> nya ord per dag hinner du:</div>${rows}`;
  }
  // Överhoppade ord kan ångras: ordet blir nytt igen och kommer tillbaka i
  // passet enligt sin plats i listan.
  function ignoredHtml() {
    if (!ignoredWords.length) return '';
    const shown = ignoredWords.slice(0, 60);
    return `<div class="ign">
      <div class="ign-head">Överhoppade ord (${stats.ignored})</div>
      <div class="ign-list">${shown.map(w =>
        `<button class="ign-item" data-restore="${w.id}" type="button" title="Ta tillbaka ordet till träningen">${esc(w.word)} <span>↺</span></button>`).join('')}
        ${stats.ignored > shown.length ? `<span class="ign-more">och ${stats.ignored - shown.length} till</span>` : ''}</div>
      ${ignoredWords.length > 1 ? `<button class="link-btn ign-all" id="ign-all" type="button">↺ Ta tillbaka alla</button>` : ''}
    </div>`;
  }
  function bindIgnored() {
    app.querySelectorAll('[data-restore]').forEach(btn => btn.onclick = async () => {
      btn.disabled = true;
      await api('POST', { action: 'unignore', wordId: Number(btn.dataset.restore) });
      settingsOpen = true;
      load();
    });
    const all = document.getElementById('ign-all');
    if (all) all.onclick = async () => {
      all.disabled = true;
      await api('POST', { action: 'unignore', all: true });
      settingsOpen = true;
      load();
    };
  }

  function settingsHtml() {
    return `
      <div class="settings">
        <div class="set-row">
          <span class="set-label">Nya ord per dag</span>
          <div class="stepper"><button class="st-btn" data-set="new" data-d="-1" type="button">−</button><b id="v-new">${settings.newPer}</b><button class="st-btn" data-set="new" data-d="1" type="button">+</button></div>
        </div>
        <div class="calc" id="calc">${calcInner()}</div>
        <button class="set-more" id="set-more" type="button">⚙ Fler inställningar <span>${settingsOpen ? '▴' : '▾'}</span></button>
        <div id="set-extra" ${settingsOpen ? '' : 'hidden'}>
          <div class="set-row">
            <span class="set-label">Max-repetitioner</span>
            <div class="stepper"><button class="st-btn" data-set="rev" data-d="-5" type="button">−</button><b id="v-rev">${settings.reviewPer}</b><button class="st-btn" data-set="rev" data-d="5" type="button">+</button></div>
          </div>
          <p class="set-note">Högsta antal repetitioner i ett pass. De som inte får plats försvinner inte, de kommer tillbaka i nästa pass samma dag.</p>
          ${ignoredHtml()}
        </div>
      </div>`;
  }

  function todayLine() {
    if (!hasSession) return `<b>${settings.newPer} nya ord</b> + <b>0 repetitioner</b>`;
    const news = session.filter(w => w.isNew).length;
    return `<b>${news} nya ord</b> + <b>${session.length - news} repetitioner</b>`;
  }
  function startSlot() {
    // Gäst utan konto ännu: knappen finns, kontot skapas först vid klick.
    if (!hasSession) {
      return `<div class="btn-row"><button class="btn btn-primary" id="go">Starta passet (${settings.newPer} ord)</button></div>`;
    }
    // Ett pass per dag: när dagens kvot nya ord är slut får man vänta till
    // imorgon eller höja gränsen, precis som i vanliga repetitionsappar.
    const doneToday = newLeft === 0 && stats.today > 0;
    if (session.length > 0) {
      return `<div class="btn-row"><button class="btn btn-primary" id="go">Starta passet (${session.length} ord)</button></div>`;
    }
    return doneToday
      ? `<div class="empty"><div class="big">✅</div><p>Dagens ${stats.today} nya ord är klara och inga repetitioner är förfallna. Vill du hinna mer idag kan du höja antalet nya ord per dag, annars ses vi imorgon.</p></div>`
      : `<div class="empty"><div class="big">🎉</div><p>Inget att träna just nu, allt är repeterat. Höj antalet nya ord eller kom tillbaka senare.</p></div>`;
  }
  function bindStart() {
    const go = document.getElementById('go');
    if (!go) return;
    go.onclick = async () => {
      if (!hasSession) {
        go.disabled = true;
        await ensureSession();
        if (!hasSession) { go.disabled = false; return; }
        // Gästens val i steppern innan kontot fanns följer med in.
        if (settings.newPer !== 10 || settings.reviewPer !== 100) {
          await api('POST', { action: 'settings', newPer: settings.newPer, reviewPer: settings.reviewPer });
        }
        const data = await api('GET');
        session = data.session || [];
        if (data.stats) stats = data.stats;
        newLeft = data.newLeft || 0;
        ignoredWords = data.ignoredWords || [];
        if (data.settings) settings = data.settings;
        if (!session.length) { renderStart(); return; }
      }
      learnI = 0;
      session.some(w => w.isNew) ? renderLearn() : beginQuiz();
    };
  }

  function renderStart() {
    const pct = stats.total ? Math.round((stats.learned / stats.total) * 100) : 0;
    app.innerHTML = frame('Ordträning', 'Dagens pass', 0, `
      <div class="ring-row">
        <div ${ring(pct)}><div>${faceHtml(stats.learned, stats.total)}</div></div>
        <div class="ring-level">Nivå <b>${faceLevel(stats.learned, stats.total)}</b> av ${FACE_STEPS.length + 1}</div>
        <div class="ring-count"><b>${stats.learned}</b> av ${stats.total} ord påbörjade</div>
        ${streak > 0 ? `<div class="streak" title="${trainedToday ? 'Du har tränat idag' : 'Träna idag för att behålla din svit'}">🔥 ${streak} ${streak === 1 ? 'dag' : 'dagar'} i rad</div>` : ''}
        <div class="stat-line today-line" id="today-line">${todayLine()}</div>
      </div>
      <div class="stat-lines">
        <div class="stat-line"><span class="dot" style="background:#f59e0b"></span><b>${stats.due}</b>&nbsp;ord att repetera nu</div>
        <div class="stat-line"><span class="dot" style="background:#2563eb"></span><b>${stats.learned - stats.strong}</b>&nbsp;på inlärning</div>
        <div class="stat-line"><span class="dot" style="background:#10b981"></span><b>${stats.strong}</b>&nbsp;sitter säkert</div>
      </div>
      ${settingsHtml()}
      <div id="start-slot">${startSlot()}</div>
      <div class="mode-row" id="mode-row">
        <button class="mode-btn" id="mode-random" type="button"><img class="mode-bg" src="/ordtraning/tarningar-bg.webp" alt=""><span class="mode-txt"><b>Slumpat ordtest</b><span>Valfritt antal slumpade ord, påverkar inte repetitionerna</span></span></button>
        <button class="mode-btn" id="mode-list" type="button"><img class="mode-bg" src="/ordtraning/ordbok-bg.webp" alt=""><span class="mode-txt"><b>Ordlista</b><span>Bläddra bland alla ${stats.total} ord och minnesregler</span></span></button>
      </div>
      ${hasSession ? '<p class="reset-line"><button id="reset-all" class="link-btn" type="button">↺ Återställ hela träningen</button></p>' : ''}`);
    bindFace();
    bindStart();
    bindIgnored();
    document.getElementById('mode-random').onclick = async () => { await ensureSession(); renderRandomSetup(); };
    document.getElementById('mode-list').onclick = async () => { await ensureSession(); renderList(); };
    app.querySelectorAll('.st-btn').forEach(btn => btn.onclick = () => changeSetting(btn.dataset.set, Number(btn.dataset.d)));
    document.getElementById('set-more').onclick = () => {
      settingsOpen = !settingsOpen;
      const extra = document.getElementById('set-extra');
      extra.hidden = !settingsOpen;
      document.querySelector('#set-more span').textContent = settingsOpen ? '▴' : '▾';
    };
    const resetAll = document.getElementById('reset-all');
    if (resetAll) resetAll.onclick = async () => {
      if (confirm('Vill du återställa hela träningen? All inlärning och alla intervall nollställs och du börjar om från första ordet.')) {
        await api('POST', { action: 'reset' });
        load();
      }
    };
  }

  let saveTimer = null;
  function changeSetting(which, delta) {
    if (which === 'new') settings.newPer = Math.max(0, Math.min(40, settings.newPer + delta));
    else settings.reviewPer = Math.max(5, Math.min(250, settings.reviewPer + delta));
    const el = document.getElementById(which === 'new' ? 'v-new' : 'v-rev');
    if (el) el.textContent = which === 'new' ? settings.newPer : settings.reviewPer;
    const calc = document.getElementById('calc');
    if (calc && which === 'new') calc.innerHTML = calcInner();
    if (!hasSession) {
      // Inget konto att spara i ännu: uppdatera bara vyn, valet skickas med
      // när gästkontot skapas vid start.
      newLeft = settings.newPer;
      const line = document.getElementById('today-line');
      if (line) line.innerHTML = todayLine();
      const slot = document.getElementById('start-slot');
      if (slot) { slot.innerHTML = startSlot(); bindStart(); }
      return;
    }
    clearTimeout(saveTimer);
    saveTimer = setTimeout(async () => {
      await api('POST', { action: 'settings', newPer: settings.newPer, reviewPer: settings.reviewPer });
      // Hämta om passet, men rita bara om det som faktiskt ändras. Ringen och
      // ansiktet står kvar, så de inte animeras om vid varje knapptryck.
      const data = await api('GET');
      session = data.session || [];
      newLeft = data.newLeft || 0;
      if (data.stats) stats = data.stats;
      learnI = 0; quizQueue = []; quizTotal = 0; resultsMap = {};
      const line = document.getElementById('today-line');
      const slot = document.getElementById('start-slot');
      if (line) line.innerHTML = todayLine();
      if (slot) { slot.innerHTML = startSlot(); bindStart(); }
    }, 450);
  }

  // ---------- Slumpat ordtest (fristående, rör inte repetitionssystemet) ----------
  let rtWords = [], rtI = 0, rtResults = [], rtCount = 20, rtDirect = true, rtView = 0;

  const RT_NOTE_DIRECT = 'Rätt svar och hela ordkortet med minnesregel visas direkt efter varje svar.';
  const RT_NOTE_AFTER = 'Du svarar på alla frågor först, som på riktiga provet, och får facit och ordkorten på resultatsidan.';

  function renderRandomSetup() {
    app.innerHTML = frame('Slumpat ordtest', 'Sporadisk träning', 0, `
      <img class="hero" src="/ordtraning/tarningar-bg.webp" alt="">
      ${guestNudgeHtml()}
      <p class="mode-lead">Ett fristående test med slumpade ord från hela listan. Resultatet påverkar inte dina repetitioner.</p>
      <div class="settings">
        <div class="set-row">
          <span class="set-label">Antal ord</span>
          <div class="stepper"><button class="st-btn" id="rt-minus" type="button">−</button><b id="rt-n">${rtCount}</b><button class="st-btn" id="rt-plus" type="button">+</button></div>
        </div>
        <div class="set-row">
          <span class="set-label">Visa facit</span>
          <div class="seg" id="rt-seg">
            <button type="button" data-v="1" class="${rtDirect ? 'is-on' : ''}">Direkt</button>
            <button type="button" data-v="0" class="${rtDirect ? '' : 'is-on'}">Efter testet</button>
          </div>
        </div>
        <p class="set-note" id="rt-note">${rtDirect ? RT_NOTE_DIRECT : RT_NOTE_AFTER}</p>
      </div>
      <div class="btn-row"><button class="btn btn-primary" id="rt-go">Starta testet</button></div>`, 'Tillbaka till översikten');
    document.getElementById('back').onclick = renderStart;
    bindGuestNudge();
    const upd = d => { rtCount = Math.max(5, Math.min(100, rtCount + d)); document.getElementById('rt-n').textContent = rtCount; };
    document.getElementById('rt-minus').onclick = () => upd(-5);
    document.getElementById('rt-plus').onclick = () => upd(5);
    app.querySelectorAll('#rt-seg button').forEach(b => b.onclick = () => {
      rtDirect = b.dataset.v === '1';
      app.querySelectorAll('#rt-seg button').forEach(x => x.classList.toggle('is-on', x === b));
      document.getElementById('rt-note').textContent = rtDirect ? RT_NOTE_DIRECT : RT_NOTE_AFTER;
    });
    document.getElementById('rt-go').onclick = async () => {
      const btn = document.getElementById('rt-go');
      btn.disabled = true; btn.textContent = 'Blandar ord…';
      const d = await fetch('/api/ordtraning?action=random&count=' + rtCount).then(r => r.json()).catch(() => null);
      if (!d || !d.test || !d.test.length) { btn.disabled = false; btn.textContent = 'Starta testet'; return; }
      rtWords = d.test; rtI = 0; rtView = 0; rtResults = [];
      renderRandomQuiz();
    };
  }

  function rtCardHtml(w) {
    return `
      ${w.image ? `<img class="fb-img" src="${w.image}" alt="">` : ''}
      ${w.etymology ? `<div class="ety"><span class="ety-label">Etymologi</span>${esc(w.etymology)}</div>` : ''}
      ${w.mnemonic ? `<div class="mnemo"><div class="m-label">Minnesregel</div><p>${hooks(w.mnemonic)}</p></div>` : ''}
      ${w.example ? `<p class="example"><span class="ex-label">Exempel</span>»${w.example}«</p>` : ''}`;
  }

  // rtView är frågan som visas. Ligger den före rtI bläddrar man bland sina
  // tidigare svar (facit syns bara i direktläget), annars är det frågan man
  // ska svara på.
  function renderRandomQuiz() {
    if (rtI >= rtWords.length) { renderRandomDone(); return; }
    if (rtView > rtI) rtView = rtI;
    const reviewing = rtView < rtI;
    const w = rtWords[rtView];
    const res = reviewing ? rtResults[rtView] : null;
    const optHtml = w.options.map((o, i) => {
      let cls = 'opt';
      if (reviewing) {
        const chosen = res.chosen === o;
        if (rtDirect) {
          if (o === w.correct) cls += ' correct';
          else if (chosen) cls += ' wrong';
          else cls += ' dim';
        } else {
          cls += chosen ? ' chosen' : ' dim';
        }
      }
      return `<button class="${cls}" data-o="${esc(o)}"${reviewing ? ' disabled' : ''}><span class="letter">${'ABCDE'[i]}</span><span>${esc(o)}</span></button>`;
    }).join('');
    app.innerHTML = frame('Slumpat ordtest', `${rtView + 1} av ${rtWords.length}`, (rtView / rtWords.length) * 100, `
      <p class="q-label">${reviewing ? `Ditt svar${rtDirect ? '' : ' – facit visas efter testet'}` : 'Vad betyder ordet?'}</p>
      <h2 class="w-word">${esc(w.word)}</h2>
      <div class="opts${reviewing ? ' answered' : ''}">${optHtml}</div>
      <div id="fb">${reviewing && rtDirect ? rtCardHtml(w) : ''}</div>
      ${rtView > 0 || reviewing ? `<div class="rt-nav">
        ${rtView > 0 ? '<button type="button" id="rt-prev">‹ Föregående</button>' : '<span class="spacer"></span>'}
        ${reviewing ? '<button type="button" id="rt-return">Framåt ›</button>' : ''}
      </div>` : ''}`, 'Avbryt testet');
    document.getElementById('back').onclick = renderStart;
    const prev = document.getElementById('rt-prev');
    if (prev) prev.onclick = () => { rtView--; renderRandomQuiz(); };
    const ret = document.getElementById('rt-return');
    if (ret) ret.onclick = () => { rtView++; renderRandomQuiz(); };
    if (!reviewing) app.querySelectorAll('.opt').forEach(btn => btn.onclick = () => rtAnswer(btn, w));
  }

  function rtAnswer(btn, w) {
    const chosen = btn.getAttribute('data-o');
    const ok = chosen === w.correct;
    rtResults.push({ w, chosen, ok });
    const goNext = () => { rtI++; rtView = rtI; renderRandomQuiz(); };
    if (!rtDirect) {
      // Facit väntar till resultatsidan: markera valet kort och gå vidare.
      app.querySelectorAll('.opt').forEach(b => { b.disabled = true; if (b !== btn) b.classList.add('dim'); });
      btn.classList.add('chosen');
      setTimeout(goNext, 280);
      return;
    }
    app.querySelectorAll('.opt').forEach(b => {
      const v = b.getAttribute('data-o');
      if (v === w.correct) b.classList.add('correct');
      else if (b === btn) b.classList.add('wrong');
      else b.classList.add('dim');
      b.onclick = goNext;
    });
    btn.insertAdjacentHTML('beforeend', '<span class="next-arrow">→</span>');
    const optsBox = app.querySelector('.opts');
    if (optsBox) optsBox.classList.add('answered');
    const last = rtI === rtWords.length - 1;
    document.getElementById('fb').innerHTML = `
      <p class="verdict ${ok ? 'ok' : 'no'}">${ok ? 'Rätt! ✓' : 'Fel, rätt svar är markerat.'}</p>
      ${rtCardHtml(w)}
      <div class="btn-row"><button class="btn btn-primary" id="nq">${last ? 'Visa resultatet' : 'Nästa fråga'}</button></div>`;
    document.getElementById('nq').onclick = goNext;
  }

  function renderRandomDone() {
    const right = rtResults.filter(r => r.ok).length;
    const rows = rtResults.map((r, i) => `
      <div class="rt-item">
        <button class="rt-row" data-i="${i}" type="button">
          <span class="mark" style="color:${r.ok ? '#10b981' : '#ef4444'}">${r.ok ? '✓' : '✗'}</span>
          <span class="rt-word">${esc(r.w.word)}</span>
          <span class="rt-def">${esc(r.w.definition)}</span>
          <span class="rt-arrow">▾</span>
        </button>
        <div class="rt-body" hidden>
          ${r.ok ? '' : `<p class="rt-chosen">Du svarade: ${esc(r.chosen)}</p>`}
          ${r.w.image ? `<img class="fb-img" src="${r.w.image}" alt="">` : ''}
          ${r.w.etymology ? `<div class="ety"><span class="ety-label">Etymologi</span>${esc(r.w.etymology)}</div>` : ''}
          ${r.w.mnemonic ? `<div class="mnemo"><div class="m-label">Minnesregel</div><p>${hooks(r.w.mnemonic)}</p></div>` : ''}
          ${r.w.example ? `<p class="example"><span class="ex-label">Exempel</span>»${r.w.example}«</p>` : ''}
        </div>
      </div>`).join('');
    app.innerHTML = frame('Slumpat ordtest', 'Resultat', 100, `
      <div class="done-head"><div class="big">${right}<span style="color:#64748b;font-size:1.4rem">/${rtResults.length}</span></div><div class="sub">rätt. Klicka på ett ord för betydelse och minnesregel.</div></div>
      <div class="rt-list">${rows}</div>
      <div class="btn-row"><button class="btn btn-primary" id="rt-again">Nytt test</button><button class="btn btn-outline" id="home">Klart</button></div>`, 'Tillbaka till översikten');
    document.getElementById('back').onclick = renderStart;
    document.getElementById('rt-again').onclick = renderRandomSetup;
    document.getElementById('home').onclick = renderStart;
    app.querySelectorAll('.rt-row').forEach(b => b.onclick = () => {
      const bodyEl = b.parentElement.querySelector('.rt-body');
      bodyEl.hidden = !bodyEl.hidden;
      b.classList.toggle('is-open', !bodyEl.hidden);
    });
  }

  // ---------- Ordlistan (bläddra bland alla ord) ----------
  let wordList = null, listQ = '', listShown = 300;

  async function renderList() {
    if (!wordList) {
      app.innerHTML = '<div class="loading">Laddar ordlistan…</div>';
      const d = await fetch('/api/ordtraning?action=words').then(r => r.json()).catch(() => null);
      if (!d || !d.words) { renderStart(); return; }
      wordList = d.words;
    }
    listQ = ''; listShown = 300;
    app.innerHTML = frame('Ordlista', `${wordList.length} ord`, 100, `
      <img class="hero" src="/ordtraning/ordbok-bg.webp" alt="">
      ${guestNudgeHtml()}
      <input type="search" id="wl-search" class="wl-search" placeholder="Sök ord eller betydelse…">
      <div id="wl-list" class="wl-list"></div>
      <div class="btn-row" id="wl-more-row" hidden><button class="btn btn-outline" id="wl-more">Visa fler</button></div>`, 'Tillbaka till översikten');
    document.getElementById('back').onclick = renderStart;
    bindGuestNudge();
    const search = document.getElementById('wl-search');
    let t = null;
    search.oninput = () => {
      clearTimeout(t);
      t = setTimeout(() => { listQ = search.value.trim().toLowerCase(); listShown = 300; renderListRows(); }, 200);
    };
    document.getElementById('wl-more').onclick = () => { listShown += 300; renderListRows(); };
    renderListRows();
  }

  function renderListRows() {
    const box = document.getElementById('wl-list');
    if (!box) return;
    const hits = listQ
      ? wordList.filter(w => (w.word + ' ' + w.definition).toLowerCase().includes(listQ))
      : wordList;
    box.innerHTML = hits.slice(0, listShown).map(w => `
      <div class="wl-item" data-id="${w.id}">
        <button class="wl-row" type="button"><b>${esc(w.word)}</b><span class="wl-def">${esc(w.definition)}</span><span class="rt-arrow">▾</span></button>
        <div class="wl-body" hidden></div>
      </div>`).join('') || '<p class="q-label">Inga ord matchar sökningen.</p>';
    const moreRow = document.getElementById('wl-more-row');
    if (moreRow) moreRow.hidden = hits.length <= listShown;
    box.querySelectorAll('.wl-row').forEach(b => b.onclick = () => toggleListItem(b.parentElement));
  }

  // Detaljerna hämtas först när ordet öppnas, så att listan laddar snabbt.
  async function toggleListItem(item) {
    const bodyEl = item.querySelector('.wl-body');
    const row = item.querySelector('.wl-row');
    if (!bodyEl.hidden) { bodyEl.hidden = true; row.classList.remove('is-open'); return; }
    bodyEl.hidden = false;
    row.classList.add('is-open');
    if (bodyEl.dataset.loaded) return;
    bodyEl.innerHTML = '<p class="wl-loading">Laddar…</p>';
    const d = await fetch('/api/ordtraning?action=word&id=' + item.dataset.id).then(r => r.json()).catch(() => null);
    if (!d || !d.word) { bodyEl.innerHTML = '<p class="wl-loading">Kunde inte ladda ordet.</p>'; return; }
    const w = d.word;
    bodyEl.dataset.loaded = '1';
    bodyEl.innerHTML = `
      ${w.etymology ? `<div class="ety"><span class="ety-label">Etymologi</span>${esc(w.etymology)}</div>` : ''}
      ${w.related ? relatedHtml(w.related) : ''}
      ${w.image ? `<img class="w-img" src="${w.image}" alt="${esc(w.word)}">` : ''}
      ${w.mnemonic ? `<div class="mnemo"><div class="m-label">Minnesregel</div><p>${hooks(w.mnemonic)}</p></div>` : ''}
      ${w.example ? `<p class="example"><span class="ex-label">Exempel</span>»${w.example}«</p>` : ''}`;
  }

  // ---------- Introrundtur första gången man ser ett ordkort ----------
  const TOUR_FLAG = 'ot-intro-v1';

  function startTour(openBody) {
    const steps = [
      { sel: ['.w-word', '.w-def'], title: 'Ordet och betydelsen', text: 'Överst står dagens ord tillsammans med sin betydelse. Börja alltid här.' },
      { sel: ['.ety'], title: 'Etymologin', text: 'Ordets ursprung. Ofta räcker den här raden för att både förstå och minnas betydelsen.' },
      { sel: ['.rel'], title: 'Ord med samma rot', text: 'Besläktade ord som delar ursprung. Känner du igen något av dem har du en gratis minneskrok.' },
      { sel: ['#pic-body'], open: 'pic-body', title: 'Minnesregeln', text: 'Behöver du mer hjälp finns en minnesregel som gör ordet svårt att glömma.' },
      { sel: ['#ex-body'], open: 'ex-body', title: 'Exempelmeningen', text: 'Så här används ordet i en riktig mening.' },
      { sel: ['.btn-row'], title: 'Vidare', text: 'Klar med ordet? Gå till nästa. Kan du ordet sedan tidigare hoppar du över det, då räknas det bort och du får ett annat i stället.' },
      { sel: ['.card-top .step'], title: 'Din egen takt', text: 'Du väljer själv hur många nya ord du vill ha varje dag. Varje dag kommer du att få dessa samt uppmanas repetera de gamla ord som behöver repeteras med den smarta repetitionsalgoritmen. Lycka till! :)' },
    ].filter(st => st.sel.every(q => app.querySelector(q)));
    if (!steps.length) return;

    const ov = document.createElement('div');
    ov.className = 'ot-tour';
    ov.innerHTML = `
      <div class="ot-tour-shade" data-side="top"></div>
      <div class="ot-tour-shade" data-side="bottom"></div>
      <div class="ot-tour-shade" data-side="left"></div>
      <div class="ot-tour-shade" data-side="right"></div>
      <div class="ot-tour-frame"></div>
      <div class="ot-tour-tip">
        <div class="ot-tour-count"></div>
        <h4></h4><p></p>
        <div class="ot-tour-btns">
          <button class="ot-tour-skip" type="button">Hoppa över</button>
          <button class="ot-tour-next" type="button">Nästa</button>
        </div>
      </div>`;
    document.body.appendChild(ov);

    let i = 0;
    const els = () => steps[i].sel.map(q => app.querySelector(q)).filter(Boolean);

    // Placerar remsor, ram och bubbla kring aktuellt element. Anropas även
    // vid scroll och storleksändring så att hålet följer med.
    function layout() {
      const rects = els().map(e => e.getBoundingClientRect());
      if (!rects.length) return;
      const pad = 8;
      const hole = {
        left: Math.max(0, Math.min(...rects.map(r => r.left)) - pad),
        top: Math.max(0, Math.min(...rects.map(r => r.top)) - pad),
        right: Math.min(innerWidth, Math.max(...rects.map(r => r.right)) + pad),
        bottom: Math.min(innerHeight, Math.max(...rects.map(r => r.bottom)) + pad),
      };
      const S = side => ov.querySelector(`[data-side="${side}"]`).style;
      S('top').cssText = `left:0; top:0; width:100vw; height:${hole.top}px`;
      S('bottom').cssText = `left:0; top:${hole.bottom}px; width:100vw; height:${Math.max(0, innerHeight - hole.bottom)}px`;
      S('left').cssText = `left:0; top:${hole.top}px; width:${hole.left}px; height:${hole.bottom - hole.top}px`;
      S('right').cssText = `left:${hole.right}px; top:${hole.top}px; width:${Math.max(0, innerWidth - hole.right)}px; height:${hole.bottom - hole.top}px`;
      ov.querySelector('.ot-tour-frame').style.cssText =
        `left:${hole.left}px; top:${hole.top}px; width:${hole.right - hole.left}px; height:${hole.bottom - hole.top}px`;
      const tip = ov.querySelector('.ot-tour-tip');
      const th = tip.offsetHeight;
      const below = hole.bottom + 12;
      tip.style.top = (below + th < innerHeight - 8 ? below : Math.max(8, hole.top - th - 12)) + 'px';
    }

    function focusStep() {
      const st = steps[i];
      if (st.open) openBody(st.open);
      ov.querySelector('.ot-tour-count').textContent = `${i + 1} av ${steps.length}`;
      ov.querySelector('h4').textContent = st.title;
      ov.querySelector('p').textContent = st.text;
      ov.querySelector('.ot-tour-next').textContent = i === steps.length - 1 ? 'Klart, nu kör vi!' : 'Nästa';
      const first = els()[0];
      if (first) first.scrollIntoView({ block: 'center', behavior: 'auto' });
      requestAnimationFrame(layout);
    }

    const finish = () => {
      try { localStorage.setItem(TOUR_FLAG, '1'); } catch {}
      window.removeEventListener('resize', layout);
      window.removeEventListener('scroll', layout, true);
      ov.remove();
    };
    window.addEventListener('resize', layout);
    window.addEventListener('scroll', layout, true);
    ov.querySelector('.ot-tour-skip').onclick = finish;
    ov.querySelector('.ot-tour-next').onclick = () => { i++; i >= steps.length ? finish() : focusStep(); };
    focusStep();
  }

  function renderLearn() {
    const news = session.filter(w => w.isNew);
    const w = news[learnI];
    // Ord utan etymologi får minnesregeln utfälld direkt, så att kortet aldrig
    // står tomt på hjälp.
    const openMnemo = !!w.mnemonic && !w.etymology;
    const backLabel = learnI > 0 ? 'Föregående ord' : 'Tillbaka till översikten';
    app.innerHTML = frame('Nya ord', `${learnI + 1} av ${news.length}`, 5 + (learnI / news.length) * 40, `
      <div class="learn-card">
        <div style="text-align:center"><span class="chip chip-new">Nytt ord</span></div>
        <h2 class="w-word">${esc(w.word)}</h2>
        <p class="w-def">${esc(w.definition)}</p>
        <div class="ety"><span class="ety-label">Etymologi</span>${w.etymology ? esc(w.etymology) : '<span class="ety-none">—</span>'}</div>
        ${relatedHtml(w.related)}
        ${w.image ? `<img class="w-img" src="${w.image}" alt="${esc(w.word)}">` : ''}
        <div class="reveal-row">
          ${w.mnemonic ? `<button class="help-toggle${openMnemo ? ' is-open' : ''}" data-target="pic-body" type="button">Visa minnesregel</button>` : ''}
          ${w.example ? `<button class="help-toggle" data-target="ex-body" type="button">Visa exempelmening</button>` : ''}
        </div>
        ${w.mnemonic ? `<div id="pic-body" ${openMnemo ? '' : 'hidden'}><div class="mnemo"><div class="m-label">Minnesregel</div><p>${hooks(w.mnemonic)}</p></div></div>` : ''}
        ${w.example ? `<div id="ex-body" hidden><p class="example">»${w.example}«</p></div>` : ''}
      </div>
      <div class="btn-row">
        <button class="btn btn-primary" id="next">Nästa ord</button>
        <button class="btn btn-outline" id="knew" title="Ordet tas bort ur listan och du får ett nytt i stället">Kan redan, hoppa över</button>
      </div>`, backLabel);
    document.getElementById('back').onclick = () => {
      if (learnI > 0) { learnI--; renderLearn(); } else { renderStart(); }
    };
    const setOpen = (ht, open) => {
      document.getElementById(ht.dataset.target).hidden = !open;
      ht.classList.toggle('is-open', open);
    };
    const toggles = [...app.querySelectorAll('.help-toggle')];
    toggles.forEach(ht => ht.onclick = () => {
      const open = document.getElementById(ht.dataset.target).hidden;
      setOpen(ht, open);
      // Bara en av rutorna åt gången, så kortet håller sig kort.
      if (open) toggles.filter(o => o !== ht).forEach(o => setOpen(o, false));
    });
    const advance = () => { learnI++; learnI < news.length ? renderLearn() : beginQuiz(); };
    document.getElementById('next').onclick = advance;
    // Överhoppat ord lämnar listan för gott. Passet fylls på med nästa nya ord
    // så att man ändå går igenom så många nya ord som man har ställt in.
    const knew = document.getElementById('knew');
    knew.onclick = async () => {
      knew.disabled = true;
      const res = await api('POST', { action: 'ignore', wordId: w.id, have: session.map(x => x.id) });
      if (!res || !res.ok) { knew.disabled = false; return; }
      const at = session.findIndex(x => x.id === w.id);
      if (res && res.replacement) session[at] = res.replacement;
      else if (at >= 0) session.splice(at, 1);
      if (stats) { stats.total = Math.max(0, stats.total - 1); stats.ignored = (stats.ignored || 0) + 1; }
      ignoredWords.unshift({ id: w.id, word: w.word });
      const left = session.filter(x => x.isNew).length;
      learnI < left ? renderLearn() : beginQuiz();
    };

    // Första ordkortet någonsin får en guidad genomgång av kortets delar.
    let tourFlag = null;
    try { tourFlag = localStorage.getItem(TOUR_FLAG); } catch {}
    if (!tourFlag) {
      startTour(id => {
        const ht = toggles.find(t => t.dataset.target === id);
        if (ht) {
          setOpen(ht, true);
          toggles.filter(o => o !== ht).forEach(o => setOpen(o, false));
        }
      });
    }
  }

  function beginQuiz() {
    const pool = session;
    // Repetitionerna först (färskvara som riskerar glömmas), sedan de nya orden.
    // Båda grupperna blandas så att man inte kan svara på ordningen från
    // lärfasen i stället för på ordet.
    quizQueue = [...shuffle(pool.filter(w => !w.isNew)), ...shuffle(pool.filter(w => w.isNew))];
    quizTotal = quizQueue.length;
    resultsMap = {};
    renderQuiz();
  }

  function renderQuiz() {
    if (quizQueue.length === 0) { renderDone(); return; }
    const w = quizQueue[0];
    const remaining = new Set(quizQueue.map(x => x.id)).size;
    const pct = quizTotal ? 48 + ((quizTotal - remaining) / quizTotal) * 50 : 98;
    app.innerHTML = frame('Quiz', `${quizTotal - remaining + 1} av ${quizTotal}`, pct, `
      <p class="q-label">Vad betyder ordet?</p>
      <h2 class="w-word">${esc(w.word)}</h2>
      <div class="opts">${w.options.map((o, i) =>
        `<button class="opt" data-o="${esc(o)}"><span class="letter">${'ABCDE'[i]}</span><span>${esc(o)}</span></button>`).join('')}</div>
      <div id="fb"></div>`);
    app.querySelectorAll('.opt').forEach(btn => btn.onclick = () => answer(btn, w));
  }

  function answer(btn, w) {
    const chosen = btn.getAttribute('data-o');
    const ok = chosen === w.correct;
    const goNext = () => { quizQueue.length === 0 ? renderDone() : renderQuiz(); };
    // Efter svar: alla alternativ blir "gå vidare"-ytor, med en pil på det man
    // tryckte, så att tummen inte behöver flyttas.
    app.querySelectorAll('.opt').forEach(b => {
      const v = b.getAttribute('data-o');
      if (v === w.correct) b.classList.add('correct');
      else if (b === btn) b.classList.add('wrong');
      else b.classList.add('dim');
      b.onclick = goNext;
    });
    btn.insertAdjacentHTML('beforeend', '<span class="next-arrow">→</span>');
    const optsBox = app.querySelector('.opts');
    if (optsBox) optsBox.classList.add('answered');
    // Kön uppdateras synkront så att ett snabbt tryck vidare aldrig hinner före.
    const prev = resultsMap[w.id] || { word: w.word, lapsed: false };
    quizQueue.shift();
    if (ok) {
      resultsMap[w.id] = { word: w.word, ok: true, days: 1, lapsed: prev.lapsed };
    } else {
      // fel: tillbaka i kön efter några få kort (Ankis korta inlärningssteg),
      // inte längst bak i en lång kö, tills det sitter
      const gap = Math.min(quizQueue.length, 4 + Math.floor(Math.random() * 3));
      quizQueue.splice(gap, 0, w);
      resultsMap[w.id] = { word: w.word, ok: false, days: 0, lapsed: true };
    }
    const last = quizQueue.length === 0;
    api('POST', { action: 'grade', wordId: w.id, correct: ok }).then(res => {
      if (ok && resultsMap[w.id]) {
        resultsMap[w.id].days = res.days || 1;
        if (document.querySelector('.done-list')) renderDone();
      }
    });
    const cardHtml = `
      ${w.image ? `<img class="fb-img" src="${w.image}" alt="">` : ''}
      ${w.etymology ? `<div class="ety"><span class="ety-label">Etymologi</span>${esc(w.etymology)}</div>` : ''}
      <div class="mnemo"><div class="m-label">Minnesregel</div><p>${hooks(w.mnemonic)}</p></div>
      ${w.example ? `<p class="example"><span class="ex-label">Exempel</span>»${w.example}«</p>` : ''}`;
    const nextBtn = `<div class="btn-row"><button class="btn btn-primary" id="nq">${last ? 'Avsluta passet' : 'Nästa fråga'}</button></div>`;
    if (ok) {
      // Rätt svar: kompakt kvitto så att flödet håller tempot. Kortet finns
      // bakom en knapp för den som vill titta ändå.
      const nextDays = INTERVAL_DAYS[Math.min((w.box || 0) + 1, 6)] || 1;
      document.getElementById('fb').innerHTML = `
        <p class="verdict ok">Rätt! ✓ <span class="when-chip">repeteras ${whenLabel(nextDays)}</span></p>
        <button class="peek" id="peek" type="button">Visa kortet</button>
        <div id="peek-body" hidden>${cardHtml}</div>
        ${nextBtn}`;
      const peek = document.getElementById('peek');
      peek.onclick = () => {
        const bodyEl = document.getElementById('peek-body');
        bodyEl.hidden = !bodyEl.hidden;
        peek.classList.toggle('is-open', !bodyEl.hidden);
      };
    } else {
      // Fel svar: ordet börjar om från inlärningslådan, så nästa rätta svar
      // ska visa rätt intervall.
      w.box = 0;
      document.getElementById('fb').innerHTML = `
        <p class="verdict no">Inte riktigt. Så här minns du (kommer igen strax):</p>
        ${cardHtml}${nextBtn}`;
    }
    document.getElementById('nq').onclick = goNext;
  }

  function renderDone() {
    const list = Object.values(resultsMap);
    const firstTry = list.filter(r => r.ok && !r.lapsed).length;
    const rows = list.map(r =>
      `<div class="done-row ${r.lapsed ? 'rep' : 'ok'}"><span class="mark">${r.lapsed ? '↻' : '✓'}</span> ${esc(r.word)} <span class="when">${whenLabel(r.days)}</span></div>`).join('');
    // Efter passet uppmuntras gäster att skapa konto: stort första gången,
    // därefter bara en liten rad. Man kan alltid fortsätta som gäst.
    let promptDone = '1';
    try { promptDone = localStorage.getItem('ot-passprompt-done') || ''; } catch {}
    const guestBlock = !isGuest ? '' : (promptDone
      ? `<p class="gsave-line"><a href="/konto/registrera?next=/ord">Skapa ett gratis konto</a> så sparas dina framsteg säkert.</p>`
      : `<div class="gsave" id="gsave">
          <h3>Snyggt jobbat! 🎉</h3>
          <p>Du tränar just nu som gäst. Skapa ett gratis konto så sparas framstegen säkert, följer med mellan mobilen och datorn, och repetitionerna väntar på dig imorgon.</p>
          <div class="btn-row">
            <a class="btn btn-primary" href="/konto/registrera?next=/ord">Skapa gratis konto</a>
            <a class="btn btn-outline" href="/konto/login?next=/ord">Jag har redan ett konto</a>
            <button class="link-btn" id="gsave-skip" type="button">Fortsätt som gäst</button>
          </div>
        </div>`);
    app.innerHTML = frame('Passet klart', 'Klart', 100, `
      <div class="done-head"><div class="big">${firstTry}<span style="color:#64748b;font-size:1.4rem">/${list.length}</span></div><div class="sub">rätt på första försöket</div></div>
      <div class="done-list">${rows || '<p class="q-label">Inga ord i passet.</p>'}</div>
      ${guestBlock}
      <div class="btn-row"><button class="btn btn-primary" id="home">Tillbaka till översikten</button></div>`);
    document.getElementById('home').onclick = () => { load(); };
    const gskip = document.getElementById('gsave-skip');
    if (gskip) gskip.onclick = () => {
      try { localStorage.setItem('ot-passprompt-done', '1'); } catch {}
      const el = document.getElementById('gsave');
      if (el) el.remove();
    };
    if (guestBlock && !promptDone) {
      try { localStorage.setItem('ot-passprompt-done', '1'); } catch {}
    }
    maybeCelebrate();
  }

  // Gick användaren upp en nivå under passet? Då firar vi med det nya ansiktet.
  async function maybeCelebrate() {
    const r = await fetch('/api/ordtraning?action=stats').then(x => x.json()).catch(() => null);
    if (!r || !r.stats) return;
    stats = r.stats;
    const lvl = faceLevel(stats.learned, stats.total);
    if (lvl <= startLevel) return;
    startLevel = lvl; // visa bara en gång per nivå
    showLevelUp(lvl);
  }

  function showLevelUp(lvl) {
    const old = document.getElementById('lvlup');
    if (old) old.remove();
    const colors = ['#2563eb', '#f59e0b', '#10b981', '#ef4444'];
    const bits = Array.from({ length: 18 }, (_, i) =>
      `<i style="left:${(4 + Math.random() * 92).toFixed(1)}%; animation-delay:${(Math.random() * 0.6).toFixed(2)}s; background:${colors[i % colors.length]}"></i>`).join('');
    const div = document.createElement('div');
    div.className = 'ot-lvlup';
    div.id = 'lvlup';
    div.innerHTML = `
      <div class="ot-lvlup-card">
        <div class="ot-lvlup-conf">${bits}</div>
        <img class="ot-lvlup-face" src="/ordfejs/${lvl}.webp" alt="Nivå ${lvl}">
        <h3>Nivå ${lvl}!</h3>
        <p>${lvl >= FACE_STEPS.length + 1 ? 'Alla ord påbörjade. Du är i mål!' : 'Du har låst upp ett nytt ansikte.'}</p>
        <button class="btn btn-primary" id="lvlup-ok" type="button">Fortsätt</button>
      </div>`;
    document.body.appendChild(div);
    const close = () => div.remove();
    div.onclick = e => { if (e.target === div) close(); };
    document.getElementById('lvlup-ok').onclick = close;
  }

  async function dev(action, extra) {
    devMsg.textContent = '…';
    await api('POST', Object.assign({ action }, extra || {}));
    devMsg.textContent = 'Klart';
    setTimeout(() => devMsg.textContent = '', 1500);
    load();
  }
  const devDay = document.getElementById('dev-day');
  if (devDay) devDay.onclick = () => dev('simulate_day', { days: 1 });
  const devWeek = document.getElementById('dev-week');
  if (devWeek) devWeek.onclick = () => dev('simulate_day', { days: 7 });

  load();
})();
</script>
