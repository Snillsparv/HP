---
// Generell provsida för extramaterialet: ett provpass från ett tidigare
// högskoleprov, med timer, rättning och textförklaringar.
import Base from '../../layouts/Base.astro';
import { getSessionFromCookies } from '../../lib/auth.js';
import { hamtaPass, provtillfallen, antalFragor, antalForklarade, testId } from '../../lib/extraprov/register.js';
import { golvBreddning } from '../../lib/fokus/fragebank.js';
import '../../styles/fragor.css';

const { id } = Astro.params;
const pass = id ? hamtaPass(id) : undefined;
if (!pass) {
  return new Response('Provpasset finns inte', { status: 404 });
}
const tillfalle = provtillfallen.find(t => t.id === pass.tillfalle);
const tillfalleName = tillfalle?.name ?? pass.tillfalle;
const user = await getSessionFromCookies(Astro.request.headers.get('cookie'));
const antal = antalFragor(pass);
const forklarade = antalForklarade(pass);
const titel = `${tillfalleName}: ${pass.name}`;
---

<Base title={`${titel} – HPAkuten`} description={`Gör ${pass.name.toLowerCase()} från högskoleprovet ${tillfalleName.toLowerCase()} på tid, med rättning och textförklaringar. ${antal} uppgifter, ${pass.timeMinutes} minuter.`}>
  <div class="page-content">
    <div class="container" style="max-width: 700px;">
      <div id="prov-root"></div>
    </div>
  </div>

  <script define:vars={{ isLoggedIn: !!user, pass, tillfalleName, testIdValue: testId(pass), forklarade, golv: golvBreddning(), arGast: !!user?.is_guest }}>
    window.__arGast = arGast;
    window.__isLoggedIn = isLoggedIn;
    window.__pass = pass;
    window.__tillfalleName = tillfalleName;
    window.__testId = testIdValue;
    window.__forklarade = forklarade;
    window.__golv = golv;
  </script>

  <script>
    import { analyzeResults, getYrkeForScore } from '../../lib/analysis.js';
    import { generateResultImage } from '../../lib/share-image.js';
    import { laddaKatex, renderTex, questionBodyHTML, lasTextHTML, dtkDiagramHTML, resultDetailHTML, bindZoom, bindFadeIn, bindLasToggle } from '../../lib/fragor/render.js';
    import { typFor, typNamn } from '../../lib/fokus/typer.js';
    const golv: Record<string, { kategori: string; antal: number }> = (window as any).__golv || {};
    const KATEGORI_NAMN: Record<string, string> = { algebra: 'algebra', aritmetik: 'aritmetik', geometri: 'geometri', funktioner: 'funktioner och grafer', procent: 'procent', sannolikhet: 'sannolikhet', statistik: 'statistik', enheter: 'enheter', logik: 'logiskt resonemang' };
    // Länken från ett fel svar: typen, kategorin över delproven om typen är
    // för liten, och hela delprovet för ORD och LÄS.
    function tranaFor(st: ExtraDelprov, q: ExtraFraga) {
      const typ = typFor(st.type, q);
      if (typ === 'ord') return { lage: 'delprov' as const, val: 'ord', namn: 'ORD-uppgifter', fran: TEST_ID };
      if (typ === 'las') return { lage: 'delprov' as const, val: 'las', namn: 'LÄS-texter', fran: TEST_ID };
      const b = golv[typ];
      if (b) return { lage: 'kategori' as const, val: b.kategori, namn: KATEGORI_NAMN[b.kategori] || b.kategori, fran: TEST_ID, antal: b.antal };
      return { lage: 'typ' as const, val: typ, namn: typNamn(typ), fran: TEST_ID };
    }
    import type { ExtraPass, ExtraDelprov, ExtraFraga } from '../../lib/extraprov/types.js';

    const pass: ExtraPass = (window as any).__pass;
    const tillfalleName: string = (window as any).__tillfalleName;
    const TEST_ID: string = (window as any).__testId;
    const forklarade: number = (window as any).__forklarade;
    const subTests = pass.subTests;
    const provNamn = `${tillfalleName}, ${pass.name.toLowerCase()}`;

    const root = document.getElementById('prov-root')!;
    type Q = ExtraFraga & { subTest: ExtraDelprov };
    const allQuestions: Q[] = subTests.flatMap(st => st.questions.map(q => ({ ...q, subTest: st })));
    const DEFAULT_TIME = pass.timeMinutes * 60;
    const EXTENDED_TIME = pass.extendedMinutes * 60;
    let totalTime = DEFAULT_TIME;
    const answers: (number | null)[] = new Array(allQuestions.length).fill(null);
    let current = 0;
    let submitted = false;
    let timerSeconds = totalTime;
    let timerInterval: number | null = null;
    let timerPaused = false;
    let started = false;
    // Övertidsläge: tiden har gått ut, resultatet är sparat på det som hanns med,
    // men användaren gör klart resterande frågor utan tid (för träningens skull).
    let overtime = false;
    let resultSaved = false;
    let timedAnswers: (number | null)[] = [];
    let timedScore = 0;
    let saveStatus: 'server' | 'anon' | 'error' | null = null;
    let textOpen = true;

    const PROGRESS_KEY = `hp-progress-${TEST_ID}`;

    const urlParams = new URLSearchParams(window.location.search);
    const isReview = urlParams.get('review') === '1';
    async function loadReview() {
      if (!isReview) return;
      clearProgress();
      const stored = JSON.parse(localStorage.getItem('hp-results') || '{}');
      const saved = stored[TEST_ID];
      if (saved?.answers) {
        saved.answers.forEach((a: number | null, i: number) => { if (i < answers.length) answers[i] = a; });
        submitted = true;
        started = true;
        resultSaved = true;
        timerSeconds = totalTime - (saved.timeSeconds || 0);
        return;
      }
      try {
        const res = await fetch(`/api/test/results?testId=${encodeURIComponent(TEST_ID)}`);
        const data = await res.json();
        if (data.results?.length > 0) {
          const best = data.results[0];
          const serverAnswers = typeof best.answers === 'string' ? JSON.parse(best.answers) : best.answers;
          if (serverAnswers?.length) {
            serverAnswers.forEach((a: number | null, i: number) => { if (i < answers.length) answers[i] = a; });
            submitted = true;
            started = true;
            resultSaved = true;
            timerSeconds = totalTime - (best.time_seconds || 0);
          }
        }
      } catch {}
    }

    function getSavedProgress() {
      try {
        const raw = localStorage.getItem(PROGRESS_KEY);
        if (!raw) return null;
        const data = JSON.parse(raw);
        if (data?.answers?.length === allQuestions.length && data.started && !data.submitted) return data;
      } catch {}
      return null;
    }

    function saveProgress() {
      if (started && !submitted && !overtime && timerSeconds > 0) {
        const elapsed = totalTime - timerSeconds;
        localStorage.setItem(PROGRESS_KEY, JSON.stringify({ answers: [...answers], current, timerSeconds, started, submitted, elapsed }));
      }
    }

    function clearProgress() {
      localStorage.removeItem(PROGRESS_KEY);
    }

    window.addEventListener('beforeunload', (e) => {
      if (started && !submitted && !overtime && timerSeconds > 0) {
        saveProgress();
        e.preventDefault();
        e.returnValue = '';
      }
    });

    // KaTeX för formlerna
    laddaKatex();

    function fmt(s: number) { return `${Math.floor(s / 60)}:${(s % 60).toString().padStart(2, '0')}`; }

    function countScore(ans: (number | null)[]) {
      return allQuestions.reduce((sum, q, i) => sum + (ans[i] === q.correct ? 1 : 0), 0);
    }

    // Normering från passets egen tabell (gäller hela delen om 80 uppgifter,
    // så råpoängen skalas upp).
    function normera(score: number, total: number): number {
      const skalad = Math.round(score * 80 / total);
      let resultat = 0;
      for (const [lagsta, norm] of pass.normering) {
        if (skalad >= lagsta) resultat = norm;
        else break;
      }
      return resultat;
    }

    function saveAreaHTML() {
      if (saveStatus === 'server') return (window as any).__arGast
        ? '<div class="tip-box success"><strong>Resultat sparat!</strong> <a href="/konto/registrera">Skapa ett gratis konto</a> så följer resultatet och din träning med mellan enheter.</div>'
        : '<div class="tip-box success"><strong>Resultat sparat i ditt konto!</strong></div>';
      if (saveStatus === 'error') return '<div class="tip-box warning"><strong>Kunde inte spara till kontot, men resultatet finns sparat lokalt.</strong></div>';
      if (saveStatus === 'anon') return '<div class="tip-box success"><strong>Resultat sparat!</strong> <a href="/konto/registrera">Skapa ett gratis konto</a> för att spara dina resultat permanent.</div>';
      return '';
    }

    async function persistResult(score: number, ans: (number | null)[], elapsed: number) {
      const resultData = { testId: TEST_ID, score, total: allQuestions.length, answers: [...ans], timeSeconds: elapsed, date: new Date().toISOString() };
      const stored = JSON.parse(localStorage.getItem('hp-results') || '{}');
      stored[TEST_ID] = resultData;
      localStorage.setItem('hp-results', JSON.stringify(stored));
      // Postas alltid: med gästsessionen från provstarten sparas resultatet
      // på servern och räknas i fokuserad träning även utan konto.
      try {
        const res = await fetch('/api/test/results', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ testId: TEST_ID, score, total: allQuestions.length, answers: ans, timeSeconds: elapsed }),
        });
        saveStatus = res.ok ? 'server' : res.status === 401 ? 'anon' : 'error';
      } catch {
        saveStatus = (window as any).__isLoggedIn ? 'error' : 'anon';
      }
      const saveArea = document.getElementById('save-area');
      if (saveArea) saveArea.innerHTML = saveAreaHTML();
    }

    // Svar som gavs efter tiden sparas som händelser i fokuserad träning (de
    // ingår inte i provresultatet), en gång per fråga.
    let overtidPostad = false;
    function postaOvertid() {
      if (!overtime || overtidPostad) return;
      overtidPostad = true;
      allQuestions.forEach((q, i) => {
        if (timedAnswers[i] === null && answers[i] !== null) {
          fetch('/api/fokus/svar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ questionId: `${TEST_ID}#${q.num}`, chosen: answers[i], lage: 'overtid' }),
          }).catch(() => {});
        }
      });
    }

    function renderTimeUp() {
      const answered = timedAnswers.filter(a => a !== null).length;
      const remaining = allQuestions.length - answered;
      if (remaining === 0) { submitted = true; render(); return; }
      root.innerHTML = `
        <div style="text-align:center; padding:3rem 0;">
          <div style="font-size:3rem; margin-bottom:0.5rem;">⏱</div>
          <h2 style="margin:0 0 1rem;">Tiden är ute!</h2>
          <p style="color:var(--color-muted); max-width:460px; margin:0 auto 0.6rem;">Provet har rättats på det du hann svara på: ${answered} av ${allQuestions.length} frågor. Resultatet är sparat.</p>
          <p style="color:var(--color-muted); max-width:460px; margin:0 auto 2rem;">Vill du göra klart ${remaining === 1 ? 'den sista frågan' : `de ${remaining} frågor som är kvar`} i lugn och ro först, för träningens skull? Svaren efter tiden räknas inte in i resultatet, men rättas så att du kan lära dig av dem.</p>
          <div style="display:flex; flex-direction:column; gap:0.8rem; align-items:center;">
            <button class="btn btn-primary" id="btn-overtime" style="font-size:1.05rem; padding:0.9rem 2.5rem;">Gör klart resten (utan tid)</button>
            <button class="btn btn-outline" id="btn-show-results" style="padding:0.7rem 2rem;">Visa rättningen direkt</button>
          </div>
        </div>
      `;
      document.getElementById('btn-overtime')?.addEventListener('click', () => {
        overtime = true;
        const firstUnanswered = answers.findIndex(a => a === null);
        if (firstUnanswered !== -1) current = firstUnanswered;
        render();
      });
      document.getElementById('btn-show-results')?.addEventListener('click', () => { submitted = true; render(); });
    }

    function startTimer() {
      timerInterval = setInterval(() => {
        if (!timerPaused) {
          timerSeconds--;
          const el = document.getElementById('timer-val');
          if (el) el.textContent = fmt(timerSeconds);
          if (timerSeconds <= 0) {
            clearInterval(timerInterval!);
            timerSeconds = 0;
            clearProgress();
            timedAnswers = [...answers];
            timedScore = countScore(timedAnswers);
            resultSaved = true;
            persistResult(timedScore, timedAnswers, totalTime);
            renderTimeUp();
          }
        }
      }, 1000) as unknown as number;
    }

    function renderStart() {
      const isKvant = pass.kind === 'kvant';
      const delar = subTests.map(st => st.shortName).join(' + ');
      const forklaringsText = forklarade === allQuestions.length
        ? 'Det här passet är extramaterial utanför stegen på Träna-sidan. Det finns inga videor, men efter rättningen får du en textförklaring till varje uppgift.'
        : forklarade > 0
          ? `Det här passet är extramaterial utanför stegen på Träna-sidan. Det finns inga videor, men ${forklarade} av ${allQuestions.length} uppgifter har textförklaring. Resten har bara facit än så länge.`
          : 'Det här passet är extramaterial utanför stegen på Träna-sidan. Det finns inga videor än, bara facit. Textförklaringar kommer.';
      root.innerHTML = `
        <div style="text-align:center; padding: 3rem 0;">
          <p style="margin:0 0 0.4rem; font-size:0.8rem; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; color:var(--color-muted);">Extramaterial · ${tillfalleName}</p>
          <h1 style="font-size:1.8rem; margin:0 0 1.5rem;">${pass.name}</h1>
          <img src="${isKvant ? '/kvant.webp' : '/verb.webp'}" alt="${isKvant ? 'Kvantitativt prov' : 'Verbalt prov'}" width="280" height="280" loading="lazy" style="width:280px; height:280px; margin-bottom:1.5rem; border-radius:var(--radius);" data-fadein />
          <div style="display:flex; justify-content:center; gap:3rem; margin-bottom: 2.5rem;">
            <div>
              <div style="font-size:2.8rem; font-weight:800; color:var(--color-primary);">${allQuestions.length}</div>
              <div style="color:var(--color-muted); font-size:0.85rem;">uppgifter</div>
            </div>
            <div>
              <div style="font-size:2.8rem; font-weight:800; color:var(--color-primary);" id="time-display">${pass.timeMinutes}:00</div>
              <div style="color:var(--color-muted); font-size:0.85rem;">minuter</div>
            </div>
          </div>
          <p style="margin:-1.5rem 0 2rem; color:var(--color-muted); font-size:0.9rem;">${delar}</p>
          <div style="text-align:left; max-width:440px; margin:0 auto 2rem; color:var(--color-muted); font-size:0.88rem; line-height:1.7;">
            <p style="margin-bottom:0.6rem;">Se till att du inte kommer att bli störd de närmaste ${pass.timeMinutes} minuterna. Sätt din telefon på stör ej, precis som på provet.${isKvant ? ' Se till att du har <strong>papper</strong>, <strong>penna</strong> och <strong>linjal</strong> redo.' : ''}</p>
            <p style="margin-bottom:0;">${isKvant ? 'Jag rekommenderar att du gör provet på datorn för att se diagrammen bättre, men att göra det på mobilen fungerar också.' : 'Jag rekommenderar att du gör provet på datorn för att se texterna bättre, men att göra det på mobilen fungerar också.'}</p>
          </div>
          <div class="tip-box" style="max-width:440px; margin:0 auto 2rem; font-size:0.88rem; text-align:left;">${forklaringsText}</div>
          <div style="max-width:440px; margin:0 auto 1.5rem; text-align:left;">
            <label style="display:flex; align-items:center; gap:0.6rem; cursor:pointer; font-size:0.88rem; color:var(--color-muted);">
              <input type="checkbox" id="extended-time" style="width:18px; height:18px;" />
              <span>Förlängd provtid (${pass.extendedMinutes} min), för dig med rätt till extra tid</span>
            </label>
          </div>
          ${!isKvant ? '<div class="tip-box warning" style="max-width:440px; margin:0 auto 2rem; font-size:0.88rem; text-align:left;">ELF-delen (engelsk läsförståelse) ingår inte eftersom de engelska texterna är upphovsrättsskyddade och inte publiceras av UHR. Passet har därför 30 uppgifter i stället för 40.</div>' : ''}
          ${!(window as any).__isLoggedIn ? '<div style="max-width:440px; margin:0 auto 1.5rem; padding:1rem; background:#eff6ff; border:1px solid #bfdbfe; border-radius:var(--radius); font-size:0.85rem; text-align:left; color:#1e40af;"><strong>Tips:</strong> <a href="#" onclick="event.preventDefault(); window.openSignupModal();" style="color:#1e40af; text-decoration:underline;">Skapa ett konto</a> för att spara dina resultat och se din utveckling. Det är helt frivilligt och kostar inget. Du kan också fortsätta utan konto!</div>' : ''}
          ${getSavedProgress() ? `
            <div style="display:flex; flex-direction:column; gap:0.8rem; align-items:center;">
              <button class="btn btn-primary" id="btn-resume" style="font-size:1.2rem; padding:1rem 4rem;">Fortsätt där du var</button>
              <button class="btn btn-outline" id="btn-restart" style="font-size:0.95rem; padding:0.7rem 2rem;">Börja om från början</button>
            </div>
          ` : `
            <button class="btn btn-primary" id="btn-start" style="font-size:1.2rem; padding:1rem 4rem;">Starta provet</button>
          `}
          <p style="margin-top:1.5rem;"><a href="/extra" style="font-size:0.88rem; color:var(--color-muted);">← Alla extraprov</a></p>
        </div>
      `;
      document.getElementById('extended-time')?.addEventListener('change', (e) => {
        const checked = (e.target as HTMLInputElement).checked;
        const td = document.getElementById('time-display');
        if (td) td.textContent = checked ? `${pass.extendedMinutes}:00` : `${pass.timeMinutes}:00`;
      });
      // En gästsession skapas vid start (en aktiv handling), så att resultatet
      // sparas på servern och räknas i fokuserad träning även utan konto.
      const sakraSession = () => {
        if ((window as any).__isLoggedIn) return;
        fetch('/api/auth/guest', { method: 'POST' }).then(r => r.json()).then(r => { if (r && r.ok) { (window as any).__isLoggedIn = true; (window as any).__arGast = !!r.guest; } }).catch(() => {});
      };
      const starta = () => {
        sakraSession();
        clearProgress();
        const ext = document.getElementById('extended-time') as HTMLInputElement | null;
        if (ext?.checked) totalTime = EXTENDED_TIME;
        timerSeconds = totalTime;
        started = true;
        startTimer();
        render();
      };
      document.getElementById('btn-start')?.addEventListener('click', starta);
      document.getElementById('btn-restart')?.addEventListener('click', starta);
      document.getElementById('btn-resume')?.addEventListener('click', () => {
        sakraSession();
        const prog = getSavedProgress();
        if (prog) {
          prog.answers.forEach((a: number | null, i: number) => { if (i < answers.length) answers[i] = a; });
          current = prog.current || 0;
          timerSeconds = prog.timerSeconds || totalTime;
        }
        started = true;
        startTimer();
        render();
      });
    }

    function render() {
      if (!started) { renderStart(); return; }
      if (submitted) { renderResults(); return; }
      const q = allQuestions[current];
      const st = q.subTest;
      const labels = ['A', 'B', 'C', 'D', 'E'];

      const diagramHTML = dtkDiagramHTML(q, st);

      const locked = overtime && timedAnswers[current] !== null;
      root.innerHTML = `
        <div class="prov-top-bar">
          <span class="prov-section-tag">${st.shortName}</span>
          ${overtime
            ? '<span class="prov-overtime-tag">Övertid · resultatet sparat</span>'
            : `<span class="prov-timer-bar">
            <span id="timer-val">${fmt(timerSeconds)}</span>
            <button class="btn-timer-toggle" id="btn-pause">${timerPaused ? '▶' : '⏸'}</button>
          </span>`}
        </div>
        <div class="pq-progress">Uppgift ${current + 1} av ${allQuestions.length}</div>
        ${diagramHTML}
        ${lasTextHTML(q, st, textOpen)}
        <div class="pq-card">
          ${questionBodyHTML(q, st)}
          <div class="pq-options">
            ${q.options.map((opt, i) => `
              <label class="pq-opt ${answers[current] === i ? 'pq-opt--sel' : ''} ${locked ? 'pq-opt--locked' : ''}">
                <input type="radio" name="q${current}" value="${i}" ${answers[current] === i ? 'checked' : ''} ${locked ? 'disabled' : ''} />
                <span class="pq-letter">${labels[i]}</span>
                <span class="pq-opt-text">${opt}</span>
              </label>
            `).join('')}
          </div>
          ${locked ? '<div class="pq-locked-note">🔒 Besvarad inom provtiden. Svaret är låst och ingår i ditt sparade resultat.</div>' : ''}
        </div>
        <div class="pq-nav">
          <div class="pq-nav-main">
            <button class="btn btn-outline btn-sm" id="btn-prev" ${current === 0 ? 'disabled' : ''}>Föregående</button>
            <button class="btn btn-primary btn-sm" id="btn-next">Nästa</button>
          </div>
          <div style="display:flex; gap:0.6rem; align-items:center;">
            <button class="btn btn-sm btn-overview-link" id="btn-overview">Översikt</button>
            ${answers.filter(a => a === null).length === 0
              ? '<button class="btn btn-sm btn-outline" id="btn-submit" style="color:var(--color-success); border-color:var(--color-success);">Rätta provet</button>'
              : `<button class="btn btn-sm btn-outline" id="btn-submit" style="opacity:0.5;">Rätta (${answers.filter(a => a !== null).length}/${allQuestions.length})</button>`}
          </div>
        </div>
        <div class="pq-dots">${allQuestions.map((_, i) => `<span class="pq-dot ${i === current ? 'pq-dot--cur' : ''} ${answers[i] !== null ? 'pq-dot--ans' : ''}" data-i="${i}">${i + 1}</span>`).join('')}</div>
      `;
      bindEvents();
    }

    function bindEvents() {
      root.querySelectorAll('input[type="radio"]').forEach(el => {
        el.addEventListener('change', (e) => { answers[current] = Number((e.target as HTMLInputElement).value); render(); });
      });
      document.getElementById('btn-prev')?.addEventListener('click', () => { current--; render(); window.scrollTo({ top: 0 }); });
      document.getElementById('btn-next')?.addEventListener('click', () => { current = (current + 1) % allQuestions.length; render(); window.scrollTo({ top: 0 }); });
      document.getElementById('btn-submit')?.addEventListener('click', () => {
        const unanswered = answers.filter(a => a === null).length;
        let msg = 'Vill du rätta provet?';
        if (unanswered > 0) msg = `Du har ${unanswered} obesvarade frågor. Vill du rätta ändå?`;
        if (confirm(msg)) { submitted = true; clearProgress(); if (timerInterval) clearInterval(timerInterval); render(); }
      });
      document.getElementById('btn-overview')?.addEventListener('click', renderOverview);
      document.getElementById('btn-pause')?.addEventListener('click', () => { timerPaused = !timerPaused; render(); });
      bindLasToggle(root, open => { textOpen = open; });
      root.querySelectorAll('.pq-dot').forEach(el => {
        el.addEventListener('click', () => { current = Number(el.getAttribute('data-i')); render(); });
      });
      bindZoom(root);
      bindFadeIn(root);
      renderTex();
    }

    function renderOverview() {
      const labels = ['A', 'B', 'C', 'D', 'E'];
      const answered = answers.filter(a => a !== null).length;
      let html = `
        <div class="prov-top-bar">
          <span>Översikt</span>
          ${overtime
            ? '<span class="prov-overtime-tag">Övertid · resultatet sparat</span>'
            : `<span class="prov-timer-bar"><span id="timer-val">${fmt(timerSeconds)}</span><button class="btn-timer-toggle" id="btn-pause">${timerPaused ? '▶' : '⏸'}</button></span>`}
        </div>
        <p style="text-align:center;color:var(--color-muted);">${answered} av ${allQuestions.length} besvarade</p>
      `;
      for (const st of subTests) {
        const qs = allQuestions.filter(q => q.subTest.id === st.id);
        const startIdx = allQuestions.indexOf(qs[0]);
        html += `<h3 style="margin:1.5rem 0 0.5rem; font-size:0.95rem;">${st.shortName}</h3><div class="pq-overview">`;
        qs.forEach((q, i) => {
          const gi = startIdx + i;
          html += `<button class="pq-ov-btn ${answers[gi] !== null ? 'pq-ov-btn--ans' : ''}" data-i="${gi}"><span class="pq-ov-num">${q.num}</span><span class="pq-ov-val">${answers[gi] !== null ? labels[answers[gi]!] : '–'}</span></button>`;
        });
        html += `</div>`;
      }
      html += `<div class="pq-nav" style="margin-top:1.5rem;">
        <button class="btn btn-outline btn-sm" id="btn-back">Tillbaka</button>
        <button class="btn btn-primary btn-sm" id="btn-submit">Rätta provet</button>
      </div>`;
      root.innerHTML = html;
      root.querySelectorAll('.pq-ov-btn').forEach(el => {
        el.addEventListener('click', () => { current = Number(el.getAttribute('data-i')); render(); });
      });
      document.getElementById('btn-back')?.addEventListener('click', () => render());
      document.getElementById('btn-submit')?.addEventListener('click', () => {
        const unanswered = answers.filter(a => a === null).length;
        let msg = 'Vill du rätta provet?';
        if (unanswered > 0) msg = `Du har ${unanswered} obesvarade frågor. Vill du rätta ändå?`;
        if (confirm(msg)) { submitted = true; clearProgress(); if (timerInterval) clearInterval(timerInterval); render(); }
      });
      document.getElementById('btn-pause')?.addEventListener('click', () => { timerPaused = !timerPaused; renderOverview(); });
    }

    async function renderResults() {
      const labels = ['A', 'B', 'C', 'D', 'E'];
      const elapsed = totalTime - timerSeconds;

      let resultsHTML = '';
      let totalScore = 0;
      for (const st of subTests) {
        const qs = allQuestions.filter(q => q.subTest.id === st.id);
        const startIdx = allQuestions.indexOf(qs[0]);
        let score = 0;
        qs.forEach((q, i) => { if (answers[startIdx + i] === q.correct) score++; });
        totalScore += score;
        resultsHTML += `
          <h3 style="margin:1.5rem 0 0.5rem;">${st.shortName}: ${score}/${qs.length}</h3>
          <div class="pq-results">${qs.map((q, i) => {
            const gi = startIdx + i;
            const ok = answers[gi] === q.correct;
            return `<div class="pq-res-wrap">
              <div class="pq-res ${ok ? 'pq-res--ok' : 'pq-res--no'}" data-toggle="res-${q.num}" style="cursor:pointer;">
                <span class="pq-res-icon">${ok ? '✓' : '✗'}</span>
                <span class="pq-res-num">${q.num}.</span>
                <span>Ditt svar: <b>${answers[gi] !== null ? labels[answers[gi]!] : '–'}</b></span>
                ${!ok ? `<span class="pq-res-right">Rätt: <b>${labels[q.correct]}</b></span>` : ''}
                <span class="pq-res-chevron">▾</span>
              </div>
              <div class="pq-res-detail" id="res-${q.num}" style="display:none;">${resultDetailHTML(q, st, answers[gi], ok ? {} : { trana: tranaFor(st, q) })}</div>
            </div>`;
          }).join('')}</div>`;
      }

      const officialScore = overtime ? timedScore : totalScore;
      const normered = normera(officialScore, allQuestions.length);
      const { summaryHTML: analysisHTML } = analyzeResults(allQuestions, answers, normered);
      const answeredInTime = timedAnswers.filter(a => a !== null).length;
      const forklaringsTips = forklarade === allQuestions.length
        ? '<strong>Klicka på en uppgift nedan</strong> för att se rätt svar och en textförklaring till hur man löser den.'
        : forklarade > 0
          ? `<strong>Klicka på en uppgift nedan</strong> för att se rätt svar. ${forklarade} av ${allQuestions.length} uppgifter har textförklaring, resten kommer.`
          : '<strong>Klicka på en uppgift nedan</strong> för att se rätt svar. Textförklaringar till det här passet kommer.';

      root.innerHTML = `
        <div class="pq-result-head">
          <h2>Resultat</h2>
          <div class="pq-normered">${normered.toFixed(1)}</div>
          <p style="color:var(--color-muted); font-size:0.9rem;">normerad poäng</p>
          <div class="pq-score" style="font-size:1.5rem; margin-top:0.5rem;">${officialScore}/${allQuestions.length}</div>
          <p style="color:var(--color-muted)">rätt svar${overtime ? ' inom provtiden' : ''} · tid: ${fmt(elapsed)}</p>
        </div>
        ${overtime ? `<div class="tip-box warning" style="margin:1.5rem 0; font-size:0.92rem;">
          <strong>Efter tiden:</strong> Ditt sparade resultat räknar de ${answeredInTime} frågor du besvarade inom provtiden (${timedScore}/${allQuestions.length} rätt). Med svaren du gjorde klart efteråt fick du ${totalScore}/${allQuestions.length} rätt. Rättningen nedan visar alla dina svar.
        </div>` : ''}
        ${analysisHTML}
        <div class="tip-box success" style="text-align:center; margin:1.5rem 0; font-size:1rem;">${forklaringsTips}</div>
        ${resultsHTML}
        <div id="save-area" style="margin-top:2rem; text-align:center;"></div>
        <div class="pq-share" style="text-align:center; margin:1.5rem 0;">
          <div id="share-preview" style="margin-bottom:1rem;"></div>
          <div style="display:flex; justify-content:center; gap:0.6rem; flex-wrap:wrap;">
            <button class="btn btn-primary btn-sm" id="btn-share-img" style="display:inline-flex; align-items:center; gap:0.4rem;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12v8a2 2 0 002 2h12a2 2 0 002-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
              Dela
            </button>
            <button class="btn btn-outline btn-sm" id="btn-download" style="display:inline-flex; align-items:center; gap:0.4rem;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Ladda ner
            </button>
          </div>
        </div>
        <div class="pq-nav" style="margin-top:1rem;">
          <button class="btn btn-outline btn-sm" id="btn-retry">Gör om provet</button>
          <a href="/extra" class="btn btn-primary btn-sm">Fler extraprov</a>
        </div>
      `;

      if (!resultSaved) {
        resultSaved = true;
        await persistResult(totalScore, answers, elapsed);
      }
      document.getElementById('save-area')!.innerHTML = saveAreaHTML();
      postaOvertid();

      root.querySelectorAll('[data-toggle]').forEach(el => {
        el.addEventListener('click', () => {
          const targetId = el.getAttribute('data-toggle')!;
          const detail = document.getElementById(targetId);
          if (detail) {
            const open = detail.style.display !== 'none';
            detail.style.display = open ? 'none' : 'block';
            el.querySelector('.pq-res-chevron')!.textContent = open ? '▾' : '▴';
            if (!open) renderTex();
          }
        });
      });
      renderTex();

      document.getElementById('btn-retry')?.addEventListener('click', () => {
        answers.fill(null); current = 0; submitted = false; timerSeconds = totalTime; timerPaused = false; started = false;
        overtime = false; resultSaved = false; timedAnswers = []; timedScore = 0; saveStatus = null;
        render();
      });

      const shareAnswers = overtime ? timedAnswers : answers;
      const stScores: { name: string; correct: number; total: number }[] = [];
      for (const st of subTests) {
        const qs = allQuestions.filter(q => q.subTest.id === st.id);
        const startIdx = allQuestions.indexOf(qs[0]);
        let sc = 0;
        qs.forEach((q, i) => { if (shareAnswers[startIdx + i] === q.correct) sc++; });
        stScores.push({ name: st.shortName, correct: sc, total: qs.length });
      }
      generateResultImage(provNamn, normered, officialScore, allQuestions.length, stScores, getYrkeForScore(normered)).then(dataUrl => {
        const preview = document.getElementById('share-preview')!;
        preview.innerHTML = `<img src="${dataUrl}" id="share-preview-img" style="max-width:300px; width:100%; border-radius:var(--radius); box-shadow:var(--shadow); cursor:pointer;" title="Klicka för att förstora" />`;
        document.getElementById('share-preview-img')?.addEventListener('click', () => {
          const overlay = document.createElement('div');
          overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.85);display:flex;align-items:center;justify-content:center;z-index:9999;cursor:pointer;padding:1rem;';
          overlay.innerHTML = `<img src="${dataUrl}" style="max-height:90vh;max-width:90vw;border-radius:8px;" />`;
          overlay.addEventListener('click', () => overlay.remove());
          document.body.appendChild(overlay);
        });
        document.getElementById('btn-share-img')?.addEventListener('click', async () => {
          try {
            const res2 = await fetch(dataUrl);
            const blob = await res2.blob();
            const file = new File([blob], 'hp-resultat.png', { type: 'image/png' });
            if (navigator.canShare?.({ files: [file] })) {
              await navigator.share({ files: [file], title: 'Mitt HP-resultat' });
            } else {
              await navigator.share({ text: 'Jag tränade på HPAkuten! www.hpakuten.se' });
            }
          } catch {}
        });
        document.getElementById('btn-download')?.addEventListener('click', () => {
          const a = document.createElement('a');
          a.href = dataUrl;
          a.download = 'hp-resultat.png';
          a.click();
        });
      });
    }

    loadReview().then(() => render());
  </script>
</Base>
