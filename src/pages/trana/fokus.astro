---
// Fokuserad träning på svagheter: tio uppgifter i taget från extramaterialet,
// per delprov, per uppgiftstyp eller viktat mot det användaren haft svårt för.
// Utan timer, med rättning och förklaring direkt efter varje svar.
import Base from '../../layouts/Base.astro';
import { getSessionFromCookies } from '../../lib/auth.js';
import { allaTyper, typVikter, DELPROV, DELPROV_NAMN, DELPROV_LANGT, typNamn } from '../../lib/fokus/fragebank.js';
import { hamtaHandelser, forStyrka } from '../../lib/fokus/historik.js';
import { beraknaStyrkor, svagasteTyper } from '../../lib/fokus/styrka.js';
import { byggKarta } from '../../lib/fokus/karta.js';
import { formatAntal } from '../../lib/extraprov/register.js';
import Styrkekarta from '../../components/Styrkekarta.astro';
import '../../styles/fragor.css';

const user = await getSessionFromCookies(Astro.request.headers.get('cookie'));
const handelser = user ? await hamtaHandelser(user.id) : [];
const styrkor = beraknaStyrkor(forStyrka(handelser));
const typer = allaTyper(['extra']);
const totalt = typer.reduce((n, t) => n + t.antal, 0);

// Typrader: delprov som har undertyper (ORD och LÄS har bara sig själva).
const typrader = DELPROV
  .map(dp => ({ dp, typer: typer.filter(t => t.delprov === dp && t.typ !== dp) }))
  .filter(r => r.typer.length > 1);

const karta = byggKarta(styrkor, typer);
const svagaste = svagasteTyper(styrkor, 3, typVikter());
const harSvagheter = svagaste.length > 0;
const typNamnMap: Record<string, string> = Object.fromEntries(typer.map(t => [t.typ, t.namn]));
for (const dp of DELPROV) typNamnMap[dp] = DELPROV_NAMN[dp];
---

<Base title="Fokusera på dina svagheter – HPAkuten" description={`Träna på just de uppgiftstyper du behöver: välj delprov eller typ, eller låt verktyget välja utifrån dina svagheter. ${formatAntal(totalt)} uppgifter från tidigare högskoleprov med förklaring direkt efter varje svar.`}>
  <div class="page-content">
    <div class="container" style="max-width: 700px;">
      <div id="fokus-val">
        <h1>Fokusera på dina svagheter</h1>
        <p class="page-intro">Tio uppgifter i taget från tidigare högskoleprov, utan tid och med förklaring direkt efter varje svar. Välj vad du vill träna på, eller låt mig välja utifrån det du haft svårt för.</p>

        <section class="fokus-block fokus-block--svag">
          <h2>Mina svagheter</h2>
          {harSvagheter ? (
            <p>Mest att hämta just nu: <strong>{svagaste.map(s => typNamnMap[s.typ] || s.typ).join(', ')}</strong>. Jag blandar uppgifter från de typerna med lite annat insprängt, så att det inte blir ren drill.</p>
          ) : (
            <p>När du gjort ett prov eller en runda här vet jag vad du har svårast för, och kan välja uppgifter åt dig. Börja med ett delprov eller en typ nedan.</p>
          )}
          <button class="btn btn-primary fokus-start" data-lage="svagheter" data-val="" disabled={!harSvagheter}>Kör tio uppgifter</button>
        </section>

        <section class="fokus-block">
          <h2>Ett delprov</h2>
          <p>Slumpade uppgifter ur alla {formatAntal(totalt)} i extramaterialet.</p>
          <div class="fokus-chips">
            {DELPROV.map(dp => (
              <button class="fokus-chip fokus-start" data-lage="delprov" data-val={dp} title={DELPROV_LANGT[dp]}>{DELPROV_NAMN[dp]}</button>
            ))}
          </div>
        </section>

        <section class="fokus-block">
          <h2>En uppgiftstyp</h2>
          <p>Mer specifikt: en kategori inom ett delprov.</p>
          {typrader.map(r => (
            <div class="fokus-typrad">
              <span class="fokus-typrad-label">{DELPROV_NAMN[r.dp]}</span>
              <div class="fokus-chips">
                {r.typer.map(t => (
                  <button class="fokus-chip fokus-chip--typ fokus-start" data-lage="typ" data-val={t.typ}>{typNamn(t.typ).replace(/^\S+ /, '')} <span class="fokus-chip-antal">{t.antal}</span></button>
                ))}
              </div>
            </div>
          ))}
        </section>

        <section class="fokus-block">
          <h2>Så här ligger du till</h2>
          {karta.length === 0 ? (
            <p>Här ser du hur det går per uppgiftstyp när du börjat träna. Både proven och rundorna här räknas.</p>
          ) : (
            <Fragment>
              <p>Andel rätt per uppgiftstyp, där nya svar väger mer än gamla. Klicka på en rad för att träna på just den typen.</p>
              <Styrkekarta rader={karta} />
            </Fragment>
          )}
        </section>

        {!user || user.is_guest ? (
          <div class="tip-box" style="font-size:0.9rem;">
            <strong>Tips:</strong> <a href="#" onclick="event.preventDefault(); window.openSignupModal();">Skapa ett gratis konto</a> så sparas din träning och dina styrkor följer med mellan enheter. Du kan träna utan konto också.
          </div>
        ) : null}
      </div>

      <div id="fokus-runda" style="display:none;"></div>
    </div>
  </div>

  <script define:vars={{ harSession: !!user, arGast: !!user?.is_guest, typNamnMap }}>
    window.__fokus = { harSession, arGast, typNamnMap };
  </script>

  <script>
    import { laddaKatex, renderTex, questionBodyHTML, lasTextHTML, dtkDiagramHTML, forklaringHTML, resultDetailHTML, bindZoom, bindFadeIn, bindLasToggle, LABELS } from '../../lib/fragor/render.js';
    import type { Fraga, Delprov } from '../../lib/fragor/render.js';
    import { rekommendationFor } from '../../lib/fokus/rekommendationer.js';

    interface KlientFraga extends Fraga {
      id: string;
      delprov: string;
      typ: string;
      grupp: string | null;
      shortName: string;
      lasText?: { title: string; html: string };
    }
    interface Enhet { grupp: string | null; fragor: KlientFraga[] }
    interface Runda { lage: string; val: string; rubrik: string; enheter: Enhet[]; antalFragor: number }
    interface Svar { fraga: KlientFraga; chosen: number | null; ratt: boolean; correct: number; explanation: string | null; videoId: string | null }

    const fokus = (window as any).__fokus as { harSession: boolean; arGast: boolean; typNamnMap: Record<string, string> };
    const valRoot = document.getElementById('fokus-val')!;
    const root = document.getElementById('fokus-runda')!;
    laddaKatex();

    let runda: Runda | null = null;
    let platta: KlientFraga[] = [];
    let idx = 0;
    let svar: Svar[] = [];
    let startTid = 0;
    let textOpen = true;
    let laddar = false;

    function delprovFor(q: KlientFraga): Delprov {
      const texts: { title: string; html: string }[] = [];
      if (q.lasText) texts[q.textIndex ?? 0] = q.lasText;
      return { id: q.delprov, shortName: q.shortName, type: q.delprov, texts: texts.length ? texts : undefined };
    }

    async function sakraSession() {
      if (fokus.harSession) return;
      try {
        const r = await fetch('/api/auth/guest', { method: 'POST' }).then(x => x.json());
        if (r && r.ok) { fokus.harSession = true; fokus.arGast = !!r.guest; }
      } catch {}
    }

    async function startaRunda(lage: string, val: string, antal = 0) {
      if (laddar) return;
      laddar = true;
      valRoot.style.display = 'none';
      root.style.display = 'block';
      root.innerHTML = '<p style="text-align:center; color:var(--color-muted); padding:3rem 0;">Väljer uppgifter …</p>';
      window.scrollTo({ top: 0 });
      await sakraSession();
      try {
        const res = await fetch(`/api/fokus/runda?lage=${encodeURIComponent(lage)}&val=${encodeURIComponent(val)}${antal ? `&antal=${antal}` : ''}`);
        const data = await res.json();
        if (!res.ok || data.error) throw new Error(data.error || 'fel');
        runda = data;
        platta = data.enheter.flatMap((e: Enhet) => e.fragor);
        idx = 0;
        svar = [];
        textOpen = true;
        const url = new URL(window.location.href);
        url.searchParams.set('lage', lage);
        if (val) url.searchParams.set('val', val); else url.searchParams.delete('val');
        url.searchParams.delete('antal');
        history.replaceState(null, '', url.toString());
        renderFraga();
      } catch (e: any) {
        const msg = e?.message === 'ingen_historik'
          ? 'Jag vet inte vad du har svårt för ännu. Gör ett prov eller en runda med ett delprov först.'
          : 'Det gick inte att hämta uppgifter just nu. Prova igen om en stund.';
        root.innerHTML = `<div class="tip-box warning">${msg}</div><p><button class="btn btn-outline btn-sm" id="btn-tillbaka">Tillbaka</button></p>`;
        document.getElementById('btn-tillbaka')?.addEventListener('click', tillbaka);
      }
      laddar = false;
    }

    function tillbaka() {
      // Laddar om sidan så att styrkekartan visar de nya svaren.
      const url = new URL(window.location.href);
      url.search = '';
      window.location.href = url.toString();
    }

    function renderFraga() {
      const q = platta[idx];
      const st = delprovFor(q);
      const grupp = q.grupp;
      // Frågor som delar diagram eller text visas med sin plats i gruppen.
      const iGrupp = grupp ? platta.filter(x => x.grupp === grupp) : [];
      const gruppText = iGrupp.length > 1 ? ` · ${grupp && q.delprov === 'las' ? 'texten' : 'diagrammet'} har ${iGrupp.length} frågor` : '';
      root.innerHTML = `
        <div class="prov-top-bar">
          <span class="prov-section-tag">${runda!.rubrik}</span>
          <button class="btn-timer-toggle" id="btn-avbryt" title="Avsluta rundan">✕</button>
        </div>
        <div class="pq-progress">Uppgift ${idx + 1} av ${platta.length}${gruppText}</div>
        ${dtkDiagramHTML(q, st)}
        ${lasTextHTML(q, st, textOpen)}
        <div class="pq-card">
          ${questionBodyHTML(q, st)}
          <div class="pq-options">
            ${q.options.map((opt, i) => `
              <button class="pq-opt" data-oi="${i}" type="button">
                <span class="pq-letter">${LABELS[i]}</span>
                <span class="pq-opt-text">${opt}</span>
              </button>
            `).join('')}
          </div>
          <div id="fokus-fb"></div>
        </div>
        <div class="pq-nav" id="fokus-nav">
          <button class="btn btn-outline btn-sm" id="btn-hoppa" type="button">Vet inte, visa svaret</button>
        </div>
      `;
      startTid = performance.now();
      root.querySelectorAll('.pq-opt').forEach(el => {
        el.addEventListener('click', () => besvara(Number(el.getAttribute('data-oi'))));
      });
      document.getElementById('btn-hoppa')?.addEventListener('click', () => besvara(null));
      document.getElementById('btn-avbryt')?.addEventListener('click', () => {
        if (svar.length === 0 || confirm('Vill du avsluta rundan? Svaren du gett är sparade.')) {
          if (svar.length > 0) renderSammanfattning(); else tillbaka();
        }
      });
      bindLasToggle(root, open => { textOpen = open; });
      bindZoom(root);
      bindFadeIn(root);
      renderTex();
    }

    async function besvara(chosen: number | null) {
      const q = platta[idx];
      const timeMs = Math.round(performance.now() - startTid);
      // Lås alternativen direkt så att dubbelklick inte ger två svar.
      root.querySelectorAll('.pq-opt').forEach(el => { el.classList.add('pq-opt--klar'); (el as HTMLButtonElement).disabled = true; });
      document.getElementById('btn-hoppa')?.remove();
      let data: any = null;
      try {
        const res = await fetch('/api/fokus/svar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ questionId: q.id, chosen, timeMs }),
        });
        data = await res.json();
      } catch {}
      if (!data || data.error) {
        document.getElementById('fokus-fb')!.innerHTML = '<div class="tip-box warning" style="margin:1rem 0 0;">Kunde inte rätta just nu. Prova igen.</div>';
        root.querySelectorAll('.pq-opt').forEach(el => { el.classList.remove('pq-opt--klar'); (el as HTMLButtonElement).disabled = false; });
        return;
      }
      const ratt = !!data.ratt;
      svar.push({ fraga: q, chosen, ratt, correct: data.correct, explanation: data.explanation, videoId: data.videoId });
      root.querySelectorAll('.pq-opt').forEach(el => {
        const oi = Number(el.getAttribute('data-oi'));
        if (oi === data.correct) el.classList.add('pq-opt--ratt');
        else if (oi === chosen) el.classList.add('pq-opt--fel');
      });
      const rubrik = ratt
        ? '<strong>Rätt!</strong>'
        : chosen === null
          ? `<strong>Rätt svar är ${LABELS[data.correct]}.</strong>`
          : `<strong>Inte rätt den här gången.</strong> Rätt svar är ${LABELS[data.correct]}.`;
      const sista = idx === platta.length - 1;
      document.getElementById('fokus-fb')!.innerHTML = `
        <div class="fokus-fb ${ratt ? 'fokus-fb--ok' : 'fokus-fb--no'}">${rubrik}</div>
        ${forklaringHTML({ ...q, explanation: data.explanation || undefined, videoId: data.videoId || undefined })}
      `;
      document.getElementById('fokus-nav')!.innerHTML = `
        <span style="font-size:0.85rem; color:var(--color-muted);">${svar.filter(s => s.ratt).length} rätt av ${svar.length}</span>
        <button class="btn btn-primary" id="btn-nasta" type="button">${sista ? 'Visa resultat' : 'Nästa'}</button>
      `;
      const nasta = document.getElementById('btn-nasta')!;
      nasta.addEventListener('click', () => { if (sista) renderSammanfattning(); else { idx++; renderFraga(); window.scrollTo({ top: 0 }); } });
      nasta.focus({ preventScroll: true });
      renderTex();
    }

    function renderSammanfattning() {
      const antalRatt = svar.filter(s => s.ratt).length;
      const perTyp = new Map<string, { ratt: number; antal: number }>();
      for (const s of svar) {
        const t = perTyp.get(s.fraga.typ) || { ratt: 0, antal: 0 };
        t.antal++;
        if (s.ratt) t.ratt++;
        perTyp.set(s.fraga.typ, t);
      }
      const typRader = [...perTyp.entries()].sort((a, b) => a[1].ratt / a[1].antal - b[1].ratt / b[1].antal);
      // Genomgångar för den typ som gick sämst i rundan (vid lika: den första).
      const svagastTyp = typRader.find(([, t]) => t.ratt < t.antal)?.[0] || typRader[0]?.[0];
      const rek = svagastTyp ? rekommendationFor(svagastTyp) : null;
      const rekHTML = rek ? `<div class="fokus-rek">
          <p class="fokus-rek-label">Vill du ha hjälp med ${fokus.typNamnMap[svagastTyp!] || svagastTyp}?</p>
          <div class="fokus-rek-lankar">
            <a href="${rek.strategi.url}">${rek.strategi.namn}</a>
            ${rek.matte.map(m => `<a href="${m.url}">Matterepetition: ${m.namn}</a>`).join('')}
          </div>
        </div>` : '';
      const beromm = antalRatt === svar.length ? 'Alla rätt, snyggt!' : antalRatt >= svar.length * 0.7 ? 'Bra jobbat!' : 'Bra att du tränar på det som är svårt, det är så man höjer sig.';
      root.innerHTML = `
        <div class="pq-result-head">
          <h2>Klart!</h2>
          <div class="pq-score">${antalRatt}/${svar.length}</div>
          <p style="color:var(--color-muted)">rätt · ${runda!.rubrik}</p>
          <p>${beromm}</p>
        </div>
        ${typRader.length > 1 ? `<div class="fokus-sammanf-typer">${typRader.map(([typ, t]) => `<button class="fokus-sammanf-rad fokus-start" data-lage="typ" data-val="${typ}"><span>${fokus.typNamnMap[typ] || typ}</span><span class="fokus-sammanf-varde ${t.ratt === t.antal ? 'ok' : t.ratt / t.antal < 0.5 ? 'no' : ''}">${t.ratt} av ${t.antal}</span></button>`).join('')}</div>` : ''}
        <div class="pq-nav" style="margin:1.5rem 0; justify-content:center; gap:0.8rem;">
          <button class="btn btn-primary fokus-start" data-lage="${runda!.lage}" data-val="${runda!.val || ''}">Kör tio till</button>
          <button class="btn btn-outline" id="btn-valj">Välj något annat</button>
        </div>
        ${rekHTML}
        ${fokus.arGast || !fokus.harSession ? '<div class="tip-box" style="font-size:0.9rem;"><strong>Tips:</strong> <a href="#" onclick="event.preventDefault(); window.openSignupModal();">Skapa ett gratis konto</a> så sparas din träning permanent och dina styrkor följer med mellan enheter.</div>' : ''}
        <h3 style="margin:2rem 0 0.5rem;">Uppgifterna i rundan</h3>
        <p style="font-size:0.85rem; color:var(--color-muted); margin-bottom:0.8rem;">Klicka på en uppgift för att se den och förklaringen igen.</p>
        <div class="pq-results">${svar.map((s, i) => `<div class="pq-res-wrap">
          <div class="pq-res ${s.ratt ? 'pq-res--ok' : 'pq-res--no'}" data-toggle="fres-${i}" style="cursor:pointer;">
            <span class="pq-res-icon">${s.ratt ? '✓' : '✗'}</span>
            <span class="pq-res-num">${i + 1}.</span>
            <span>${fokus.typNamnMap[s.fraga.typ] || s.fraga.typ}</span>
            ${!s.ratt ? `<span class="pq-res-right">Rätt: <b>${LABELS[s.correct]}</b></span>` : ''}
            <span class="pq-res-chevron">▾</span>
          </div>
          <div class="pq-res-detail" id="fres-${i}" style="display:none;">${resultDetailHTML({ ...s.fraga, correct: s.correct, explanation: s.explanation || undefined, videoId: s.videoId || undefined }, delprovFor(s.fraga), s.chosen)}</div>
        </div>`).join('')}</div>
      `;
      root.querySelectorAll('[data-toggle]').forEach(el => {
        el.addEventListener('click', () => {
          const detail = document.getElementById(el.getAttribute('data-toggle')!);
          if (!detail) return;
          const open = detail.style.display !== 'none';
          detail.style.display = open ? 'none' : 'block';
          el.querySelector('.pq-res-chevron')!.textContent = open ? '▾' : '▴';
          if (!open) renderTex();
        });
      });
      document.getElementById('btn-valj')?.addEventListener('click', tillbaka);
      bindStart(root);
      renderTex();
      window.scrollTo({ top: 0 });
    }

    function bindStart(scope: ParentNode) {
      scope.querySelectorAll<HTMLButtonElement>('.fokus-start').forEach(btn => {
        btn.addEventListener('click', () => startaRunda(btn.dataset.lage || 'delprov', btn.dataset.val || ''));
      });
    }
    bindStart(valRoot);

    // Direktlänk från rättningen: /trana/fokus?lage=typ&val=xyz:algebra
    const params = new URLSearchParams(window.location.search);
    const lage = params.get('lage');
    if (lage === 'delprov' || lage === 'typ' || lage === 'svagheter') {
      startaRunda(lage, params.get('val') || '', Number(params.get('antal') || 0));
    }
  </script>
</Base>

<style is:global>
  .fokus-block { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); padding: 1.2rem 1.4rem; margin-bottom: 1.2rem; box-shadow: var(--shadow); }
  .fokus-block h2 { margin: 0 0 0.4rem; font-size: 1.15rem; }
  .fokus-block > p { margin: 0 0 0.9rem; font-size: 0.92rem; color: var(--color-muted); line-height: 1.6; }
  .fokus-block--svag { border-color: #2563eb; background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); }
  .fokus-block--svag > p { color: #1e3a8a; }
  .fokus-block--svag .btn[disabled] { opacity: 0.5; cursor: default; }
  .fokus-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .fokus-chip { font-family: var(--font-sans); font-weight: 700; font-size: 0.95rem; padding: 0.55rem 1rem; border: 2px solid var(--color-border); border-radius: 999px; background: var(--color-surface); cursor: pointer; transition: all 0.12s; color: var(--color-text); }
  .fokus-chip:hover { border-color: var(--color-primary); color: var(--color-primary); }
  .fokus-chip--typ { font-weight: 600; font-size: 0.88rem; padding: 0.4rem 0.8rem; }
  .fokus-chip-antal { color: var(--color-muted); font-weight: 500; font-size: 0.78rem; margin-left: 0.15rem; }
  .fokus-typrad { display: flex; gap: 0.8rem; align-items: flex-start; margin-bottom: 0.7rem; }
  .fokus-typrad-label { flex: 0 0 3rem; font-weight: 800; font-size: 0.8rem; color: var(--color-primary); letter-spacing: 0.06em; padding-top: 0.5rem; }
  .fokus-fb { margin-top: 1rem; padding: 0.8rem 1rem; border-radius: var(--radius); font-size: 0.95rem; }
  .fokus-fb--ok { background: #ecfdf5; color: #065f46; }
  .fokus-fb--no { background: #fef2f2; color: #991b1b; }
  .fokus-rek { max-width: 420px; margin: 0 auto 1.2rem; padding: 0.9rem 1.1rem; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: var(--radius); }
  .fokus-rek-label { margin: 0 0 0.4rem; font-weight: 700; font-size: 0.9rem; color: #166534; }
  .fokus-rek-lankar { display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.9rem; }
  .fokus-sammanf-typer { display: flex; flex-direction: column; gap: 0.3rem; max-width: 420px; margin: 0 auto; }
  .fokus-sammanf-rad { display: flex; justify-content: space-between; gap: 1rem; padding: 0.5rem 0.9rem; border: 1px solid var(--color-border); border-radius: var(--radius); background: var(--color-surface); cursor: pointer; font-family: var(--font-sans); font-size: 0.92rem; color: var(--color-text); }
  .fokus-sammanf-rad:hover { border-color: var(--color-primary); }
  .fokus-sammanf-varde { font-weight: 700; color: var(--color-muted); }
  .fokus-sammanf-varde.ok { color: #16a34a; }
  .fokus-sammanf-varde.no { color: #ef4444; }
  @media (max-width: 480px) {
    .fokus-block { padding: 1rem; }
    .fokus-typrad { flex-direction: column; gap: 0.3rem; }
    .fokus-typrad-label { padding-top: 0; }
  }
</style>
