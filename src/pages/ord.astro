  .ot-page .mode-lead { font-size: 0.88rem; color: #64748b; margin: 0 0 0.8rem; line-height: 1.5; }

  .ot-page .rt-list { display: flex; flex-direction: column; gap: 0.4rem; margin: 0.8rem 0 1rem; }
